    <bpmn:sendTask implementation="##unspecified" operationRef="_83f1c680-7e06-4a9a-9206-396ed8155a71" isForCompensation="false" startQuantity="1" name="Notify Employee of Approval" id="_93ec9873-edf1-4549-b052-961994ec8234" triso:readOnly="false">
      <bpmn:extensionElements>
        <ino:profilename value="ROOT PROFILE" />
        <ino:stereotypename value="task" />
        <ino:typename value="MID.Innovator.API.icw2bp.BPTaskNode" />
        <MailTo>${email}</MailTo>
        <MailSubject>Your Vacation Request ${SYS.PROCESSINSTANCE_ID} was approved automatically</MailSubject>
        <MailBody>Dear ${first-name},
your Vacation Request ${SYS.PROCESSINSTANCE_ID}
from ${fromdatepicker}
to ${todatepicker}
was approved automatically.
Best regards,
Your BOC Adonis Process Automation</MailBody>
        <zeebe:taskDefinition type="emailService" />
        <zeebe:ioMapping>
          <zeebe:input source="= &quot;&lt;html&gt;&lt;p&gt;Hi  &quot; + Current Vacation Status.name + &quot;,&lt;/p&gt; &lt;p&gt; &lt;/p&gt; &lt;p&gt;Your vacation request from &quot; + From + &quot; to &quot; + To + &quot; was approved.&lt;/p&gt; &lt;p&gt; &lt;/p&gt; &lt;p&gt;Best regards&lt;/p&gt; &lt;p&gt; &lt;/p&gt; &lt;p&gt;This is an automated message generated by the vacation system.&lt;/p&gt;&lt;/html&gt;&quot;" target="mailBody" />
          <zeebe:input source="= &quot;Vacation Approved&quot;" target="mailSubject" />
          <zeebe:input source="= Current Vacation Status.email" target="mailAddress" />
        </zeebe:ioMapping>
        <kp:field name="to" stringValue="info@knowprocess.com" />
        <kp:field name="htmlVar" stringValue="vacationApproved" />
        <triso:dataInputBindings>
          <ns1:context>
            <ns1:contextEntry>
              <ns1:variable id="_15b345fa-3cf9-480c-94af-8254cf893070" name="ToEmail" triso:dataInputRef="_93ec9873-edf1-4549-b052-961994ec8234_ae68194f-c21d-4227-82e2-3196c4a9d54e_in" typeRef="feel:string" />
              <ns1:literalExpression id="_8e459a3a-3522-46a9-8fe8-cdc04dce7002" expressionLanguage="https://www.omg.org/spec/DMN/20191111/FEEL/">
                <ns1:text>Current Vacation Status.email</ns1:text>
              </ns1:literalExpression>
            </ns1:contextEntry>
            <ns1:contextEntry>
              <ns1:variable id="_8f40b6b3-df95-45c0-a88d-80626d15a942" name="FromEmail" triso:dataInputRef="_93ec9873-edf1-4549-b052-961994ec8234_d6361b84-796a-48f8-a056-9af3983fe14d_in" typeRef="feel:string" />
              <ns1:literalExpression id="_2699a949-3cf1-4351-b056-6766c9f6d574" expressionLanguage="https://www.omg.org/spec/DMN/20191111/FEEL/">
                <ns1:text>"vacationsystem@eurent.com"</ns1:text>
              </ns1:literalExpression>
            </ns1:contextEntry>
            <ns1:contextEntry>
              <ns1:variable id="_69562d60-3953-4633-a726-84032ed4e87d" name="Subject" triso:dataInputRef="_93ec9873-edf1-4549-b052-961994ec8234_7ea780be-73b4-4f90-8d24-47aeb544faa0_in" typeRef="feel:string" />
              <ns1:literalExpression id="_85195d1a-718c-4f1b-8dba-8ce4e66e9be8" expressionLanguage="https://www.omg.org/spec/DMN/20191111/FEEL/">
                <ns1:text>"Vacation Approved"</ns1:text>
              </ns1:literalExpression>
            </ns1:contextEntry>
            <ns1:contextEntry>
              <ns1:variable id="_f3abd20a-153e-46ed-9e2d-362d962b0622" name="Body" triso:dataInputRef="_93ec9873-edf1-4549-b052-961994ec8234_7e40320f-8779-4f5e-a519-06a7c640535d_in" typeRef="feel:string" />
              <ns1:literalExpression id="_dbb306bd-0a43-491f-a316-70aea0ca1351" expressionLanguage="http://www.w3.org/1999/xhtml">
                <ns1:text>&lt;html&gt;&lt;p&gt;Hi&amp;nbsp;&lt;span class="feel-expression"&gt;Current Vacation Status.name&lt;/span&gt;,&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;
&lt;p&gt;Your vacation request from&amp;nbsp;&lt;span class="feel-expression"&gt;date(From)&lt;/span&gt;&amp;nbsp;to &lt;span class="feel-expression"&gt;date(To)&lt;/span&gt;&amp;nbsp;was approved.&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;
&lt;p&gt;Best regards&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;
&lt;p&gt;This is an automated message generated by the vacation system.&lt;/p&gt;&lt;/html&gt;</ns1:text>
              </ns1:literalExpression>
            </ns1:contextEntry>
          </ns1:context>
