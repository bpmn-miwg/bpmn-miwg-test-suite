    <bpmn:sendTask implementation="##unspecified" operationRef="_83f1c680-7e06-4a9a-9206-396ed8155a71" isForCompensation="false" startQuantity="1" name="Notify Employee of Refusal" id="_9ed61a6a-7cc1-4ed1-86d8-03482b0983c9" triso:readOnly="false">
      <bpmn:extensionElements>
        <ino:profilename value="ROOT PROFILE" />
        <ino:stereotypename value="task" />
        <ino:typename value="MID.Innovator.API.icw2bp.BPTaskNode" />
        <MailTo>${email}</MailTo>
        <MailSubject>Your Vacation Request ${SYS.PROCESSINSTANCE_ID} was refused automatically</MailSubject>
        <MailBody>Dear ${first-name},
unfortunately your Vacation Request ${SYS.PROCESSINSTANCE_ID}
from ${fromdatepicker}
to ${todatepicker}
was refused automatically.
Number of requested days: ${result_variable_days}
Reason: ${result_variable_reason}
Please consider the reason and create a new request if necessary.
Best regards,
Your BOC Adonis Process Automation</MailBody>
        <zeebe:taskDefinition type="emailService" />
        <zeebe:ioMapping>
          <zeebe:input source="= &quot;&lt;html&gt;&lt;p&gt;Hi  &quot; + Current Vacation Status.name + &quot;,&lt;/p&gt; &lt;p&gt; &lt;/p&gt; &lt;p&gt;Your vacation request from &quot; + From + &quot; to &quot; + To + &quot; was declined for the following reason: &quot; + Reason + &quot;&lt;/p&gt; &lt;p&gt; &lt;/p&gt; &lt;p&gt;Best regards&lt;/p&gt; &lt;p&gt; &lt;/p&gt; &lt;p&gt;This is an automated message generated by the vacation system.&lt;/p&gt;&lt;/html&gt;&quot;" target="mailBody" />
          <zeebe:input source="= &quot;Vacation Denied&quot;" target="mailSubject" />
          <zeebe:input source="= Current Vacation Status.email" target="mailAddress" />
        </zeebe:ioMapping>
        <kp:field name="to" stringValue="info@knowprocess.com" />
        <kp:field name="htmlVar" stringValue="vacationRefused" />
        <triso:dataInputBindings>
          <ns1:context>
            <ns1:contextEntry>
              <ns1:variable id="_66bb75dc-0d15-4d4a-bff5-1facaa990f9d" name="ToEmail" triso:dataInputRef="_9ed61a6a-7cc1-4ed1-86d8-03482b0983c9_ae68194f-c21d-4227-82e2-3196c4a9d54e_in" typeRef="feel:string" />
              <ns1:literalExpression id="_e2eb53e8-9147-4829-9e12-227787c00697" expressionLanguage="https://www.omg.org/spec/DMN/20191111/FEEL/">
                <ns1:text>Current Vacation Status.email</ns1:text>
              </ns1:literalExpression>
            </ns1:contextEntry>
            <ns1:contextEntry>
              <ns1:variable id="_29bcd07e-f276-4020-9692-974a48f02547" name="FromEmail" triso:dataInputRef="_9ed61a6a-7cc1-4ed1-86d8-03482b0983c9_d6361b84-796a-48f8-a056-9af3983fe14d_in" typeRef="feel:string" />
              <ns1:literalExpression id="_f028dc26-6701-4c27-825f-8dc30432c7ca" expressionLanguage="https://www.omg.org/spec/DMN/20191111/FEEL/">
                <ns1:text>"vacationsystem@eurent.com"</ns1:text>
              </ns1:literalExpression>
            </ns1:contextEntry>
            <ns1:contextEntry>
              <ns1:variable id="_4865e6aa-a0ee-484c-8cc0-32a9f5f0011a" name="Subject" triso:dataInputRef="_9ed61a6a-7cc1-4ed1-86d8-03482b0983c9_7ea780be-73b4-4f90-8d24-47aeb544faa0_in" typeRef="feel:string" />
              <ns1:literalExpression id="_fc8bc676-d687-4fa1-afc3-bc8bdc51458d" expressionLanguage="https://www.omg.org/spec/DMN/20191111/FEEL/">
                <ns1:text>"Vacation Denied"</ns1:text>
              </ns1:literalExpression>
            </ns1:contextEntry>
            <ns1:contextEntry>
              <ns1:variable id="_841a17a0-858e-4f7e-9226-f95f34c2468e" name="Body" triso:dataInputRef="_9ed61a6a-7cc1-4ed1-86d8-03482b0983c9_7e40320f-8779-4f5e-a519-06a7c640535d_in" typeRef="feel:string" />
              <ns1:literalExpression id="_d1713c38-e401-4968-b789-e55f0b68e161" expressionLanguage="http://www.w3.org/1999/xhtml">
                <ns1:text>&lt;html&gt;&lt;p&gt;Hi &lt;span class="feel-expression"&gt;Current Vacation Status.name&lt;/span&gt;,&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;
&lt;p&gt;Your vacation request from&amp;nbsp;&lt;span class="feel-expression"&gt;date(From)&lt;/span&gt;&amp;nbsp;to &lt;span class="feel-expression"&gt;date(To)&lt;/span&gt;&amp;nbsp;was declined for the following reason: &lt;span class="feel-expression"&gt;Reason&lt;/span&gt;&amp;nbsp;&lt;br /&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p&gt;&amp;nbsp;Best regards&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;
&lt;p&gt;This is an automated message generated by the vacation system.&lt;/p&gt;&lt;/html&gt;</ns1:text>
              </ns1:literalExpression>
            </ns1:contextEntry>
          </ns1:context>
        </triso:dataInputBindings>
