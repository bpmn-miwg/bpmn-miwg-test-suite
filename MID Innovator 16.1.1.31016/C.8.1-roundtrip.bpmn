    <bpmn:sendTask implementation="##unspecified" operationRef="_83f1c680-7e06-4a9a-9206-396ed8155a71" isForCompensation="false" startQuantity="1" name="Notify Employee of Refusal" id="_02232e32-c3d2-473c-a15d-9c5dca00eadc" triso:readOnly="false">
      <bpmn:extensionElements>
        <ino:profilename value="ROOT PROFILE" />
        <ino:stereotypename value="task" />
        <ino:typename value="MID.Innovator.API.icw2bp.BPTaskNode" />
        <MailTo>${email}</MailTo>
        <MailSubject>Your Vacation Request ${SYS.PROCESSINSTANCE_ID} was refused manually</MailSubject>
        <MailBody>Dear ${first-name},
unfortunately your Vacation Request ${SYS.PROCESSINSTANCE_ID}
from ${fromdatepicker}
to ${todatepicker}
was refused manually.
Comment: ${comment}
Please consider the refusal comment and create a new request if necessary.
Best regards,
Your BOC Adonis Process Automation</MailBody>
        <zeebe:taskDefinition type="emailService" />
        <zeebe:ioMapping>
          <zeebe:input source="= &quot;&lt;html&gt;&lt;p&gt;Hi  &quot; + Current Vacation Status.name + &quot;,&lt;/p&gt; &lt;p&gt; &lt;/p&gt; &lt;p&gt;Your vacation request from &quot; + From + &quot; to &quot; + To + &quot; was declined for the following reason: &quot; + Reason + &quot;&lt;/p&gt; &lt;p&gt; &lt;/p&gt; &lt;p&gt;Best regards&lt;/p&gt; &lt;p&gt; &lt;/p&gt; &lt;p&gt;This is an automated message generated by the vacation system.&lt;/p&gt;&lt;/html&gt;&quot;" target="mailBody" />
          <zeebe:input source="= &quot;Vacation Denied&quot;" target="mailSubject" />
          <zeebe:input source="= Current Vacation Status.email" target="mailAddress" />
        </zeebe:ioMapping>
        <kp:field name="to" stringValue="info@knowprocess.com" />
        <kp:field name="htmlVar" stringValue="vacationRefused" />
        <triso:dataInputBindings>
          <ns1:context>
            <ns1:contextEntry>
              <ns1:variable id="_a0afa1d9-6bcc-4b00-9fb5-a0f8c8fc4ec0" name="ToEmail" triso:dataInputRef="_02232e32-c3d2-473c-a15d-9c5dca00eadc_ae68194f-c21d-4227-82e2-3196c4a9d54e_in" typeRef="feel:string" />
              <ns1:literalExpression id="_ad3d3db6-4c39-4963-9ad1-745e13823e10" expressionLanguage="https://www.omg.org/spec/DMN/20191111/FEEL/">
                <ns1:text>Current Vacation Status.email</ns1:text>
              </ns1:literalExpression>
            </ns1:contextEntry>
            <ns1:contextEntry>
              <ns1:variable id="_83e43e25-2303-4a44-8925-5433bc9abeed" name="FromEmail" triso:dataInputRef="_02232e32-c3d2-473c-a15d-9c5dca00eadc_d6361b84-796a-48f8-a056-9af3983fe14d_in" typeRef="feel:string" />
              <ns1:literalExpression id="_c5ae07b5-85ec-4967-a3cf-79ab8b1cc6f3" expressionLanguage="https://www.omg.org/spec/DMN/20191111/FEEL/">
                <ns1:text>"vacationsystem@eurent.com"</ns1:text>
              </ns1:literalExpression>
            </ns1:contextEntry>
            <ns1:contextEntry>
              <ns1:variable id="_e9877473-96c8-49a2-964c-221661bf1cf5" name="Subject" triso:dataInputRef="_02232e32-c3d2-473c-a15d-9c5dca00eadc_7ea780be-73b4-4f90-8d24-47aeb544faa0_in" typeRef="feel:string" />
              <ns1:literalExpression id="_61249fc4-ef20-40f1-a2b3-99593edaa28e" expressionLanguage="https://www.omg.org/spec/DMN/20191111/FEEL/">
                <ns1:text>"Vacation Denied"</ns1:text>
              </ns1:literalExpression>
            </ns1:contextEntry>
            <ns1:contextEntry>
              <ns1:variable id="_528bbb15-4f27-4fee-8168-e7dfb86d1880" name="Body" triso:dataInputRef="_02232e32-c3d2-473c-a15d-9c5dca00eadc_7e40320f-8779-4f5e-a519-06a7c640535d_in" typeRef="feel:string" />
              <ns1:literalExpression id="_66bf8a7a-1365-4476-b104-3c742842cd30" expressionLanguage="http://www.w3.org/1999/xhtml">
                <ns1:text>&lt;html&gt;&lt;p&gt;Hi &amp;nbsp;&amp;nbsp;&lt;span class="feel-expression"&gt;Current Vacation Status.name&lt;/span&gt;&amp;nbsp;,&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;
&lt;p&gt;Your vacation request from&amp;nbsp;&lt;span class="feel-expression"&gt;date(From)&lt;/span&gt;&amp;nbsp;to &lt;span class="feel-expression"&gt;date(To)&lt;/span&gt;&amp;nbsp;was declined for the following reason:&amp;nbsp;&lt;span class="feel-expression"&gt;Reason&lt;/span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;br /&gt;&amp;nbsp;&lt;/p&gt;
&lt;p&gt;&amp;nbsp;Best regards&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;
&lt;p&gt;This is an automated message generated by the vacation system.&lt;/p&gt;&lt;/html&gt;</ns1:text>
              </ns1:literalExpression>
            </ns1:contextEntry>
          </ns1:context>
        </triso:dataInputBindings>
        <bpanda:property name="Ausführungszeit (min)" value="0" id="property_BPActivityNode_ExecutionTime" />
        <bpanda:property name="Häufigkeit pro Jahr" value="0" id="property_BPActivityNode_FrequencyPerYear" />
        <bpanda:property name="Kosten pro Ausführung (EUR)" value="0" id="property_BPActivityNode_CostsPerExecution" />
        <bpanda:property name="Mittlere Schleifenanzahl" value="0" id="property_BPActivityNode_MeanLoopNumber" />
        <bpanda:property name="Bearbeitungsstatus" value="in Arbeit" id="label_Editing Status" />
        <bpanda:localization xml:lang="es">
          <bpanda:extensionTextTranslation name="BPMN Extension" value="&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-16&quot;?&gt;&#xA;&lt;semantic:sendTask triso:readOnly=&quot;false&quot; xmlns:triso=&quot;http://www.trisotech.com/2015/triso/modeling&quot; xmlns:semantic=&quot;http://www.omg.org/spec/BPMN/20100524/MODEL&quot; xmlns:zeebe=&quot;http://camunda.org/schema/zeebe/1.0&quot; xmlns:kp=&quot;http://knowprocess.com/bpmn&quot; xmlns:ns1=&quot;https://www.omg.org/spec/DMN/20191111/MODEL/&quot;&gt;&#xA;  &lt;semantic:extensionElements&gt;&#xA;    &lt;MailTo xmlns=&quot;http://www.boc-group.com&quot;&gt;${email}&lt;/MailTo&gt;&#xA;    &lt;MailSubject xmlns=&quot;http://www.boc-group.com&quot;&gt;Your Vacation Request ${SYS.PROCESSINSTANCE_ID} was refused manually&lt;/MailSubject&gt;&#xA;    &lt;MailBody xmlns=&quot;http://www.boc-group.com&quot;&gt;Dear ${first-name},&#xA;unfortunately your Vacation Request ${SYS.PROCESSINSTANCE_ID}&#xA;from ${fromdatepicker}&#xA;to ${todatepicker}&#xA;was refused manually.&#xA;Comment: ${comment}&#xA;Please consider the refusal comment and create a new request if necessary.&#xA;Best regards,&#xA;Your BOC Adonis Process Automation&lt;/MailBody&gt;&#xA;    &lt;zeebe:taskDefinition type=&quot;emailService&quot; /&gt;&#xA;    &lt;zeebe:ioMapping&gt;&#xA;      &lt;zeebe:input source=&quot;= &amp;quot;&amp;lt;html&amp;gt;&amp;lt;p&amp;gt;Hi  &amp;quot; + Current Vacation Status.name + &amp;quot;,&amp;lt;/p&amp;gt; &amp;lt;p&amp;gt; &amp;lt;/p&amp;gt; &amp;lt;p&amp;gt;Your vacation request from &amp;quot; + From + &amp;quot; to &amp;quot; + To + &amp;quot; was declined for the following reason: &amp;quot; + Reason + &amp;quot;&amp;lt;/p&amp;gt; &amp;lt;p&amp;gt; &amp;lt;/p&amp;gt; &amp;lt;p&amp;gt;Best regards&amp;lt;/p&amp;gt; &amp;lt;p&amp;gt; &amp;lt;/p&amp;gt; &amp;lt;p&amp;gt;This is an automated message generated by the vacation system.&amp;lt;/p&amp;gt;&amp;lt;/html&amp;gt;&amp;quot;&quot; target=&quot;mailBody&quot; /&gt;&#xA;      &lt;zeebe:input source=&quot;= &amp;quot;Vacation Denied&amp;quot;&quot; target=&quot;mailSubject&quot; /&gt;&#xA;      &lt;zeebe:input source=&quot;= Current Vacation Status.email&quot; target=&quot;mailAddress&quot; /&gt;&#xA;    &lt;/zeebe:ioMapping&gt;&#xA;    &lt;kp:field name=&quot;to&quot; stringValue=&quot;info@knowprocess.com&quot; /&gt;&#xA;    &lt;kp:field name=&quot;htmlVar&quot; stringValue=&quot;vacationRefused&quot; /&gt;&#xA;    &lt;triso:dataInputBindings&gt;&#xA;      &lt;ns1:context&gt;&#xA;        &lt;ns1:contextEntry&gt;&#xA;          &lt;ns1:variable id=&quot;_a0afa1d9-6bcc-4b00-9fb5-a0f8c8fc4ec0&quot; name=&quot;ToEmail&quot; triso:dataInputRef=&quot;_02232e32-c3d2-473c-a15d-9c5dca00eadc_ae68194f-c21d-4227-82e2-3196c4a9d54e_in&quot; typeRef=&quot;feel:string&quot; /&gt;&#xA;          &lt;ns1:literalExpression id=&quot;_ad3d3db6-4c39-4963-9ad1-745e13823e10&quot; expressionLanguage=&quot;https://www.omg.org/spec/DMN/20191111/FEEL/&quot;&gt;&#xA;            &lt;ns1:text&gt;Current Vacation Status.email&lt;/ns1:text&gt;&#xA;          &lt;/ns1:literalExpression&gt;&#xA;        &lt;/ns1:contextEntry&gt;&#xA;        &lt;ns1:contextEntry&gt;&#xA;          &lt;ns1:variable id=&quot;_83e43e25-2303-4a44-8925-5433bc9abeed&quot; name=&quot;FromEmail&quot; triso:dataInputRef=&quot;_02232e32-c3d2-473c-a15d-9c5dca00eadc_d6361b84-796a-48f8-a056-9af3983fe14d_in&quot; typeRef=&quot;feel:string&quot; /&gt;&#xA;          &lt;ns1:literalExpression id=&quot;_c5ae07b5-85ec-4967-a3cf-79ab8b1cc6f3&quot; expressionLanguage=&quot;https://www.omg.org/spec/DMN/20191111/FEEL/&quot;&gt;&#xA;            &lt;ns1:text&gt;&quot;vacationsystem@eurent.com&quot;&lt;/ns1:text&gt;&#xA;          &lt;/ns1:literalExpression&gt;&#xA;        &lt;/ns1:contextEntry&gt;&#xA;        &lt;ns1:contextEntry&gt;&#xA;          &lt;ns1:variable id=&quot;_e9877473-96c8-49a2-964c-221661bf1cf5&quot; name=&quot;Subject&quot; triso:dataInputRef=&quot;_02232e32-c3d2-473c-a15d-9c5dca00eadc_7ea780be-73b4-4f90-8d24-47aeb544faa0_in&quot; typeRef=&quot;feel:string&quot; /&gt;&#xA;          &lt;ns1:literalExpression id=&quot;_61249fc4-ef20-40f1-a2b3-99593edaa28e&quot; expressionLanguage=&quot;https://www.omg.org/spec/DMN/20191111/FEEL/&quot;&gt;&#xA;            &lt;ns1:text&gt;&quot;Vacation Denied&quot;&lt;/ns1:text&gt;&#xA;          &lt;/ns1:literalExpression&gt;&#xA;        &lt;/ns1:contextEntry&gt;&#xA;        &lt;ns1:contextEntry&gt;&#xA;          &lt;ns1:variable id=&quot;_528bbb15-4f27-4fee-8168-e7dfb86d1880&quot; name=&quot;Body&quot; triso:dataInputRef=&quot;_02232e32-c3d2-473c-a15d-9c5dca00eadc_7e40320f-8779-4f5e-a519-06a7c640535d_in&quot; typeRef=&quot;feel:string&quot; /&gt;&#xA;          &lt;ns1:literalExpression id=&quot;_66bf8a7a-1365-4476-b104-3c742842cd30&quot; expressionLanguage=&quot;http://www.w3.org/1999/xhtml&quot;&gt;&#xA;            &lt;ns1:text&gt;&amp;lt;html&amp;gt;&amp;lt;p&amp;gt;Hi &amp;amp;nbsp;&amp;amp;nbsp;&amp;lt;span class=&quot;feel-expression&quot;&amp;gt;Current Vacation Status.name&amp;lt;/span&amp;gt;&amp;amp;nbsp;,&amp;lt;/p&amp;gt;&#xA;&amp;lt;p&amp;gt;&amp;amp;nbsp;&amp;lt;/p&amp;gt;&#xA;&amp;lt;p&amp;gt;Your vacation request from&amp;amp;nbsp;&amp;lt;span class=&quot;feel-expression&quot;&amp;gt;date(From)&amp;lt;/span&amp;gt;&amp;amp;nbsp;to &amp;lt;span class=&quot;feel-expression&quot;&amp;gt;date(To)&amp;lt;/span&amp;gt;&amp;amp;nbsp;was declined for the following reason:&amp;amp;nbsp;&amp;lt;span class=&quot;feel-expression&quot;&amp;gt;Reason&amp;lt;/span&amp;gt;&amp;amp;nbsp;&amp;amp;nbsp;&amp;amp;nbsp;&amp;lt;br /&amp;gt;&amp;amp;nbsp;&amp;lt;/p&amp;gt;&#xA;&amp;lt;p&amp;gt;&amp;amp;nbsp;Best regards&amp;lt;/p&amp;gt;&#xA;&amp;lt;p&amp;gt;&amp;amp;nbsp;&amp;lt;/p&amp;gt;&#xA;&amp;lt;p&amp;gt;This is an automated message generated by the vacation system.&amp;lt;/p&amp;gt;&amp;lt;/html&amp;gt;&lt;/ns1:text&gt;&#xA;          &lt;/ns1:literalExpression&gt;&#xA;        &lt;/ns1:contextEntry&gt;&#xA;      &lt;/ns1:context&gt;&#xA;    &lt;/triso:dataInputBindings&gt;&#xA;  &lt;/semantic:extensionElements&gt;&#xA;&lt;/semantic:sendTask&gt;" />
        </bpanda:localization>
      </bpmn:extensionElements>
