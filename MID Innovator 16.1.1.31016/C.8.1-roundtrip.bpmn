    <bpmn:sendTask implementation="##unspecified" operationRef="_83f1c680-7e06-4a9a-9206-396ed8155a71" isForCompensation="false" startQuantity="1" name="Notify Employee of Approval" id="_a97c1a48-faba-447b-bfa6-7aa81a6fe0a0" triso:readOnly="false">
      <bpmn:extensionElements>
        <ino:profilename value="ROOT PROFILE" />
        <ino:stereotypename value="task" />
        <ino:typename value="MID.Innovator.API.icw2bp.BPTaskNode" />
        <MailTo>${email}</MailTo>
        <MailSubject>Your Vacation Request ${SYS.PROCESSINSTANCE_ID} was approved manually</MailSubject>
        <MailBody>Dear ${first-name},
your Vacation Request ${SYS.PROCESSINSTANCE_ID}
from ${fromdatepicker}
to ${todatepicker}
was approved manually.
Comment: ${comment}
Best regards,
Your BOC Adonis Process Automation</MailBody>
        <zeebe:taskDefinition type="emailService" />
        <zeebe:ioMapping>
          <zeebe:input source="= &quot;&lt;html&gt;&lt;p&gt;Hi  &quot; + Current Vacation Status.name + &quot;,&lt;/p&gt; &lt;p&gt; &lt;/p&gt; &lt;p&gt;Your vacation request from &quot; + From + &quot; to &quot; + To + &quot; was approved.&lt;/p&gt; &lt;p&gt; &lt;/p&gt; &lt;p&gt;Best regards&lt;/p&gt; &lt;p&gt; &lt;/p&gt; &lt;p&gt;This is an automated message generated by the vacation system.&lt;/p&gt;&lt;/html&gt;&quot;" target="mailBody" />
          <zeebe:input source="= &quot;Vacation Approved&quot;" target="mailSubject" />
          <zeebe:input source="= Current Vacation Status.email" target="mailAddress" />
        </zeebe:ioMapping>
        <kp:field name="to" stringValue="info@knowprocess.com" />
        <kp:field name="htmlVar" stringValue="vacationApproved" />
        <triso:dataInputBindings>
          <ns1:context>
            <ns1:contextEntry>
              <ns1:variable id="_ddd49085-8640-4c03-97bc-42a5eb90ab67" name="ToEmail" triso:dataInputRef="_a97c1a48-faba-447b-bfa6-7aa81a6fe0a0_ae68194f-c21d-4227-82e2-3196c4a9d54e_in" typeRef="feel:string" />
              <ns1:literalExpression id="_13e0c76b-1e39-49d8-834e-3af442b8c80a" expressionLanguage="https://www.omg.org/spec/DMN/20191111/FEEL/">
                <ns1:text>Current Vacation Status.email</ns1:text>
              </ns1:literalExpression>
            </ns1:contextEntry>
            <ns1:contextEntry>
              <ns1:variable id="_a8089c03-2b7a-49f5-9825-a2d37df508d9" name="FromEmail" triso:dataInputRef="_a97c1a48-faba-447b-bfa6-7aa81a6fe0a0_d6361b84-796a-48f8-a056-9af3983fe14d_in" typeRef="feel:string" />
              <ns1:literalExpression id="_3778b80e-0e72-4176-8b0d-1845a1d35dad" expressionLanguage="https://www.omg.org/spec/DMN/20191111/FEEL/">
                <ns1:text>"vacationsystem@eurent.com"</ns1:text>
              </ns1:literalExpression>
            </ns1:contextEntry>
            <ns1:contextEntry>
              <ns1:variable id="_d4f0605c-cb1d-4228-bb73-75e0aeef6a65" name="Subject" triso:dataInputRef="_a97c1a48-faba-447b-bfa6-7aa81a6fe0a0_7ea780be-73b4-4f90-8d24-47aeb544faa0_in" typeRef="feel:string" />
              <ns1:literalExpression id="_3c80748b-77bf-4e10-8d8b-b341d3c85bcc" expressionLanguage="https://www.omg.org/spec/DMN/20191111/FEEL/">
                <ns1:text>"Vacation Approved"</ns1:text>
              </ns1:literalExpression>
            </ns1:contextEntry>
            <ns1:contextEntry>
              <ns1:variable id="_83999af0-8f94-4828-a5af-bf44de3dc712" name="Body" triso:dataInputRef="_a97c1a48-faba-447b-bfa6-7aa81a6fe0a0_7e40320f-8779-4f5e-a519-06a7c640535d_in" typeRef="feel:string" />
              <ns1:literalExpression id="_f3627801-c024-4a94-a36c-514efa6fc3cc" expressionLanguage="http://www.w3.org/1999/xhtml">
                <ns1:text>&lt;html&gt;&lt;p&gt;Hi &amp;nbsp;&lt;span class="feel-expression"&gt;Current Vacation Status.name&lt;/span&gt;,&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;
&lt;p&gt;Your vacation request from&amp;nbsp;&lt;span class="feel-expression"&gt;date(From)&lt;/span&gt;&amp;nbsp;to &lt;span class="feel-expression"&gt;date(To)&lt;/span&gt;&amp;nbsp;was approved.&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;
&lt;p&gt;Best regards&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;
&lt;p&gt;This is an automated message generated by the vacation system.&lt;/p&gt;&lt;/html&gt;</ns1:text>
              </ns1:literalExpression>
