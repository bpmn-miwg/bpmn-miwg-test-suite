    <bpmn:serviceTask operationRef="_a0e96e19-a01f-4dde-b613-0b774e8d350b" implementation="##unspecified" isForCompensation="false" startQuantity="1" name="Update Remaining Vacation" id="_4b72053b-8ebb-4ae6-99c6-7c93cf1c1d1b" triso:readOnly="false">
      <bpmn:extensionElements>
        <ino:profilename value="ROOT PROFILE" />
        <ino:stereotypename value="task" />
        <ino:typename value="MID.Innovator.API.icw2bp.BPTaskNode" />
        <zeebe:taskDefinition type="update" />
        <kp:field name="requestMethod" stringValue="POST" />
        <kp:field expression="https://crm.knowprocess.com/miwg/contacts/${employeeBadgeNumber}/customFields" name="requestUrl" stringValue="https://crm.knowprocess.com/miwg/contacts//customFields" />
        <kp:field name="requestHeaders" stringValue="Content-Type:application/json" />
        <kp:field expression="{&quot;customFields&quot;:{&quot;vacationDays&quot;:${vacationDays}}}" name="requestBody" />
        <kp:field name="resultVariablePrefix" stringValue="upVacation1" />
        <kp:field name="saveRequestVariables" stringValue="false" />
        <kp:field name="saveResponseParameters" stringValue="true" />
        <triso:dataInputBindings>
          <ns1:context>
            <ns1:contextEntry>
              <ns1:variable id="_0fa68c24-33f6-45b9-b390-8cf6146ee754" name="employeeId" triso:dataInputRef="_4b72053b-8ebb-4ae6-99c6-7c93cf1c1d1b_429a9bc0-a05a-45c7-8217-8675b8806b69_in" typeRef="feel:number" />
              <ns1:literalExpression id="_340d3c88-f7b8-498c-965c-87b5f647fe77" expressionLanguage="https://www.omg.org/spec/DMN/20191111/FEEL/">
                <ns1:text>Employee Badge Number</ns1:text>
              </ns1:literalExpression>
            </ns1:contextEntry>
            <ns1:contextEntry>
              <ns1:variable id="_016f47b2-9713-4631-98ca-9c167be47c67" name="vacation" triso:dataInputRef="_4b72053b-8ebb-4ae6-99c6-7c93cf1c1d1b_523fbd6a-2708-4b6a-8d75-8196e38773f2_in" typeRef="simon.1.simon.input_vacation" />
              <ns1:context id="_122f4d07-2608-4904-97d3-0e171d492697">
                <ns1:contextEntry>
                  <ns1:variable id="_4c86f578-029a-4c00-b34e-d6cf0dc2a6d9" name="days" typeRef="feel:number" />
                  <ns1:literalExpression id="_fddc8686-9e10-4c11-9813-da3feaa49de0" expressionLanguage="https://www.omg.org/spec/DMN/20191111/FEEL/" triso:unparsed="true">
                    <ns1:text>Current Vacation Status.days - ((To -From).days)</ns1:text>
                  </ns1:literalExpression>
                </ns1:contextEntry>
              </ns1:context>
            </ns1:contextEntry>
          </ns1:context>
        </triso:dataInputBindings>
        <bpanda:property name="Ausführungszeit (min)" value="0" id="property_BPActivityNode_ExecutionTime" />
        <bpanda:property name="Häufigkeit pro Jahr" value="0" id="property_BPActivityNode_FrequencyPerYear" />
        <bpanda:property name="Kosten pro Ausführung (EUR)" value="0" id="property_BPActivityNode_CostsPerExecution" />
        <bpanda:property name="Mittlere Schleifenanzahl" value="0" id="property_BPActivityNode_MeanLoopNumber" />
        <bpanda:property name="Bearbeitungsstatus" value="in Arbeit" id="label_Editing Status" />
