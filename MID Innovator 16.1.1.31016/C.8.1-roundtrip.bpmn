    <bpmn:serviceTask operationRef="_dd434d56-40a4-4d63-8a22-58d8e5a5edc7" implementation="##unspecified" isForCompensation="false" startQuantity="1" name="Fetch Vacation Information" id="_2b960d84-feb1-46a9-a1a1-c300dd996b99" triso:readOnly="false">
      <bpmn:extensionElements>
        <ino:profilename value="ROOT PROFILE" />
        <ino:stereotypename value="task" />
        <ino:typename value="MID.Innovator.API.icw2bp.BPTaskNode" />
        <Events>
          <Event>
            <EventType>Node Enter</EventType>
            <ActionName>Fetch Approval</ActionName>
            <ActionClass>HttpRestHandler</ActionClass>
            <Parameters>
              <Parameter>
                <Name>hostName</Name>
                <Value>https://test-demo.trisotech.com/execution/dmn/api/run/miwg/dmn/vacation-approval</Value>
              </Parameter>
              <Parameter>
                <Name>method</Name>
                <Value>POST</Value>
              </Parameter>
              <Parameter>
                <Name>postParameter</Name>
                <Value>{    "From": "${fromdatepicker}",    "To": "${todatepicker}",    "Days Remaining": ${days-remaining}  }</Value>
              </Parameter>
              <Parameter>
                <Name>user</Name>
                <Value>bearer</Value>
              </Parameter>
