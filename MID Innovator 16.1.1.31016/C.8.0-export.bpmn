    <bpmn:serviceTask isForCompensation="false" startQuantity="1" name="Fetch Vacation Information" id="_2b960d84-feb1-46a9-a1a1-c300dd996b99" triso:readOnly="false">
      <bpmn:extensionElements>
        <ino:profilename value="ROOT PROFILE" />
        <ino:stereotypename value="task" />
        <ino:typename value="MID.Innovator.API.icw2bp.BPTaskNode" />
        <adonis:Events>
          <adonis:Event>
            <adonis:EventType>Node Enter</adonis:EventType>
            <adonis:ActionName>Fetch Approval</adonis:ActionName>
            <adonis:ActionClass>HttpRestHandler</adonis:ActionClass>
            <adonis:Parameters>
              <adonis:Parameter>
                <adonis:Name>hostName</adonis:Name>
                <adonis:Value>https://test-demo.trisotech.com/execution/dmn/api/run/miwg/dmn/vacation-approval</adonis:Value>
              </adonis:Parameter>
              <adonis:Parameter>
                <adonis:Name>method</adonis:Name>
                <adonis:Value>POST</adonis:Value>
              </adonis:Parameter>
              <adonis:Parameter>
                <adonis:Name>postParameter</adonis:Name>
                <adonis:Value>{    "From": "${fromdatepicker}",    "To": "${todatepicker}",    "Days Remaining": ${days-remaining}  }</adonis:Value>
              </adonis:Parameter>
              <adonis:Parameter>
                <adonis:Name>user</adonis:Name>
                <adonis:Value>bearer</adonis:Value>
              </adonis:Parameter>
              <adonis:Parameter>
                <adonis:Name>pass</adonis:Name>
                <adonis:Value>eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJhcHAiOiJkNmM4MTYwMS0zMTZiLTQ2NjgtOGFmMy01NWQxMTYxYzNkYTYiLCJzdWIiOiJzcmluZ3VldHRlQHRyaXNvdGVjaC5jb20iLCJpc3MiOiJ0ZXN0LWRlbW8udHJpc290ZWNoLmNvbSIsImlhdCI6MTYzNzc3MjAxNywiY2FsIjoiOTBmYTc4ZTEtMDI3ZS00YzhjLThlNTAtODJjY2ExN2M0OGVhIn0.iUzYijUAbDNPMUqJ_HzMiEq5IGNmhPwFG6ok7PkBzik</adonis:Value>
              </adonis:Parameter>
              <adonis:Parameter>
                <adonis:Name>authMethod</adonis:Name>
                <adonis:Value>basic</adonis:Value>
              </adonis:Parameter>
              <adonis:Parameter>
                <adonis:Name>searchByJsonPath</adonis:Name>
                <adonis:Value>[{path: "['results'].['Vacation Approval Status'].['Approval']", resultVariable: "result_variable"},{path: "['results'].['Vacation Approval Status'].['Reason']", resultVariable: "result_variable_reason"},{path: "['results'].['Number of days']", resultVariable: "result_variable_days"}]</adonis:Value>
              </adonis:Parameter>
            </adonis:Parameters>
          </adonis:Event>
          <adonis:Event>
            <adonis:EventType>Node Enter</adonis:EventType>
            <adonis:ActionName>Rename Instance</adonis:ActionName>
            <adonis:ActionClass>RenameInstanceHandler</adonis:ActionClass>
            <adonis:Parameters>
