          <bpanda:attributeTranslation name="name" value="Aprobar vacaciones manualmente" />
          <bpanda:extensionTextTranslation name="BPMN Extension" value="&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-16&quot;?&gt;&#xA;&lt;semantic:userTask triso:readOnly=&quot;false&quot; kp:formKey=&quot;ApproveVacation&quot; xmlns:kp=&quot;http://knowprocess.com/bpmn&quot; xmlns:triso=&quot;http://www.trisotech.com/2015/triso/modeling&quot; xmlns:semantic=&quot;http://www.omg.org/spec/BPMN/20100524/MODEL&quot; xmlns:adonis=&quot;http://www.boc-group.com&quot; xmlns:zeebe=&quot;http://camunda.org/schema/zeebe/1.0&quot; xmlns:dmn=&quot;https://www.omg.org/spec/DMN/20191111/MODEL/&quot;&gt;&#xA;  &lt;semantic:extensionElements&gt;&#xA;    &lt;adonis:Tasks&gt;&#xA;      &lt;adonis:Task&gt;&#xA;        &lt;adonis:TaskName&gt;Manually Approve Vacation&lt;/adonis:TaskName&gt;&#xA;        &lt;adonis:Description&gt;The automatic approval resulted in &quot;Manual Validation Required&quot;. Please check the Vacation Request and approve or decline it.&lt;/adonis:Description&gt;&#xA;      &lt;/adonis:Task&gt;&#xA;    &lt;/adonis:Tasks&gt;&#xA;    &lt;zeebe:formDefinition formKey=&quot;camunda-forms:bpmn:userTaskForm_1m306cp&quot; /&gt;&#xA;    &lt;adonis:instance&gt;&#xA;      &lt;adonis:attribute lang-independent=&quot;v0&quot; name=&quot;IDENTIFICATION_OF_CHANGES&quot; notebook=&quot;1&quot; novalue=&quot;0&quot; sourcelang=&quot;en&quot; type=&quot;ENUM&quot;&gt;&#xA;        &lt;adonis:value&gt;No change&lt;/adonis:value&gt;&#xA;        &lt;adonis:metavalue /&gt;&#xA;      &lt;/adonis:attribute&gt;&#xA;      &lt;adonis:attribute name=&quot;A_EXECUTION_TIME&quot; notebook=&quot;1&quot; novalue=&quot;0&quot; sourcelang=&quot;en&quot; type=&quot;UTC&quot;&gt;&#xA;        &lt;adonis:value&gt;0&lt;/adonis:value&gt;&#xA;        &lt;adonis:metavalue&gt;0&lt;/adonis:metavalue&gt;&#xA;      &lt;/adonis:attribute&gt;&#xA;      &lt;adonis:attribute name=&quot;A_RESTING_TIME&quot; notebook=&quot;1&quot; novalue=&quot;0&quot; sourcelang=&quot;en&quot; type=&quot;UTC&quot;&gt;&#xA;        &lt;adonis:value&gt;0&lt;/adonis:value&gt;&#xA;        &lt;adonis:metavalue&gt;0&lt;/adonis:metavalue&gt;&#xA;      &lt;/adonis:attribute&gt;&#xA;      &lt;adonis:attribute name=&quot;A_WAITING_TIME&quot; notebook=&quot;1&quot; novalue=&quot;0&quot; sourcelang=&quot;en&quot; type=&quot;UTC&quot;&gt;&#xA;        &lt;adonis:value&gt;0&lt;/adonis:value&gt;&#xA;        &lt;adonis:metavalue&gt;0&lt;/adonis:metavalue&gt;&#xA;      &lt;/adonis:attribute&gt;&#xA;      &lt;adonis:attribute name=&quot;DISPLAY_SYMBOLS_IF_RISKS_OR_CONTROLS&quot; notebook=&quot;1&quot; novalue=&quot;0&quot; sourcelang=&quot;en&quot; type=&quot;BOOL&quot;&gt;&#xA;        &lt;adonis:value&gt;true&lt;/adonis:value&gt;&#xA;        &lt;adonis:metavalue /&gt;&#xA;      &lt;/adonis:attribute&gt;&#xA;      &lt;adonis:attribute name=&quot;DISPLAY_COOPERATIONPARTICIPATION&quot; notebook=&quot;1&quot; novalue=&quot;0&quot; sourcelang=&quot;en&quot; type=&quot;BOOL&quot;&gt;&#xA;        &lt;adonis:value&gt;false&lt;/adonis:value&gt;&#xA;        &lt;adonis:metavalue /&gt;&#xA;      &lt;/adonis:attribute&gt;&#xA;      &lt;adonis:attribute name=&quot;DISPLAY_SYMBOL_IF_DESCRIPTION&quot; notebook=&quot;1&quot; novalue=&quot;0&quot; sourcelang=&quot;en&quot; type=&quot;BOOL&quot;&gt;&#xA;        &lt;adonis:value&gt;true&lt;/adonis:value&gt;&#xA;        &lt;adonis:metavalue /&gt;&#xA;      &lt;/adonis:attribute&gt;&#xA;      &lt;adonis:attribute name=&quot;COLLECTION_DATATYPE_INPUT&quot; notebook=&quot;1&quot; novalue=&quot;0&quot; sourcelang=&quot;en&quot; type=&quot;BOOL&quot;&gt;&#xA;        &lt;adonis:value&gt;false&lt;/adonis:value&gt;&#xA;        &lt;adonis:metavalue /&gt;&#xA;      &lt;/adonis:attribute&gt;&#xA;      &lt;adonis:attribute name=&quot;MONITORING&quot; notebook=&quot;1&quot; novalue=&quot;0&quot; sourcelang=&quot;en&quot; type=&quot;BOOL&quot;&gt;&#xA;        &lt;adonis:value&gt;false&lt;/adonis:value&gt;&#xA;        &lt;adonis:metavalue /&gt;&#xA;      &lt;/adonis:attribute&gt;&#xA;