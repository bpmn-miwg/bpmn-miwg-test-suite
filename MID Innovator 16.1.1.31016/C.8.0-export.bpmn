        <bpanda:localization xml:lang="es">
          <bpanda:attributeTranslation name="name" value="Notificar al empleado de la negativa" />
          <bpanda:extensionTextTranslation name="BPMN Extension" value="&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-16&quot;?&gt;&#xA;&lt;semantic:sendTask triso:readOnly=&quot;false&quot; xmlns:triso=&quot;http://www.trisotech.com/2015/triso/modeling&quot; xmlns:semantic=&quot;http://www.omg.org/spec/BPMN/20100524/MODEL&quot; xmlns:adonis=&quot;http://www.boc-group.com&quot; xmlns:zeebe=&quot;http://camunda.org/schema/zeebe/1.0&quot; xmlns:kp=&quot;http://knowprocess.com/bpmn&quot; xmlns:dmn=&quot;https://www.omg.org/spec/DMN/20191111/MODEL/&quot;&gt;&#xA;  &lt;semantic:extensionElements&gt;&#xA;    &lt;adonis:MailTo&gt;${email}&lt;/adonis:MailTo&gt;&#xA;    &lt;adonis:MailSubject&gt;Your Vacation Request ${SYS.PROCESSINSTANCE_ID} was refused automatically&lt;/adonis:MailSubject&gt;&#xA;    &lt;adonis:MailBody&gt;Dear ${first-name},&#xA;unfortunately your Vacation Request ${SYS.PROCESSINSTANCE_ID}&#xA;from ${fromdatepicker}&#xA;to ${todatepicker}&#xA;was refused automatically.&#xA;Number of requested days: ${result_variable_days}&#xA;Reason: ${result_variable_reason}&#xA;Please consider the reason and create a new request if necessary.&#xA;Best regards,&#xA;Your BOC Adonis Process Automation&lt;/adonis:MailBody&gt;&#xA;    &lt;zeebe:taskDefinition type=&quot;emailService&quot; /&gt;&#xA;    &lt;zeebe:ioMapping&gt;&#xA;      &lt;zeebe:input source=&quot;= &amp;quot;&amp;lt;html&amp;gt;&amp;lt;p&amp;gt;Hi  &amp;quot; + Current Vacation Status.name + &amp;quot;,&amp;lt;/p&amp;gt; &amp;lt;p&amp;gt; &amp;lt;/p&amp;gt; &amp;lt;p&amp;gt;Your vacation request from &amp;quot; + From + &amp;quot; to &amp;quot; + To + &amp;quot; was declined for the following reason: &amp;quot; + Reason + &amp;quot;&amp;lt;/p&amp;gt; &amp;lt;p&amp;gt; &amp;lt;/p&amp;gt; &amp;lt;p&amp;gt;Best regards&amp;lt;/p&amp;gt; &amp;lt;p&amp;gt; &amp;lt;/p&amp;gt; &amp;lt;p&amp;gt;This is an automated message generated by the vacation system.&amp;lt;/p&amp;gt;&amp;lt;/html&amp;gt;&amp;quot;&quot; target=&quot;mailBody&quot; /&gt;&#xA;      &lt;zeebe:input source=&quot;= source&quot; target=&quot;mailSubject&quot; /&gt;&#xA;      &lt;zeebe:input source=&quot;= Current Vacation Status.email&quot; target=&quot;mailAddress&quot; /&gt;&#xA;    &lt;/zeebe:ioMapping&gt;&#xA;    &lt;kp:field name=&quot;to&quot; stringValue=&quot;info@knowprocess.com&quot; /&gt;&#xA;    &lt;kp:field name=&quot;htmlVar&quot; stringValue=&quot;vacationRefused&quot; /&gt;&#xA;    &lt;adonis:instance&gt;&#xA;      &lt;adonis:attribute lang-independent=&quot;v0&quot; name=&quot;IDENTIFICATION_OF_CHANGES&quot; notebook=&quot;1&quot; novalue=&quot;0&quot; sourcelang=&quot;en&quot; type=&quot;ENUM&quot;&gt;&#xA;        &lt;adonis:value&gt;No change&lt;/adonis:value&gt;&#xA;        &lt;adonis:metavalue /&gt;&#xA;      &lt;/adonis:attribute&gt;&#xA;      &lt;adonis:attribute name=&quot;A_EXECUTION_TIME&quot; notebook=&quot;1&quot; novalue=&quot;0&quot; sourcelang=&quot;en&quot; type=&quot;UTC&quot;&gt;&#xA;        &lt;adonis:value&gt;0&lt;/adonis:value&gt;&#xA;        &lt;adonis:metavalue&gt;0&lt;/adonis:metavalue&gt;&#xA;      &lt;/adonis:attribute&gt;&#xA;      &lt;adonis:attribute name=&quot;A_RESTING_TIME&quot; notebook=&quot;1&quot; novalue=&quot;0&quot; sourcelang=&quot;en&quot; type=&quot;UTC&quot;&gt;&#xA;        &lt;adonis:value&gt;0&lt;/adonis:value&gt;&#xA;        &lt;adonis:metavalue&gt;0&lt;/adonis:metavalue&gt;&#xA;      &lt;/adonis:attribute&gt;&#xA;      &lt;adonis:attribute name=&quot;A_WAITING_TIME&quot; notebook=&quot;1&quot; novalue=&quot;0&quot; sourcelang=&quot;en&quot; type=&quot;UTC&quot;&gt;&#xA;        &lt;adonis:value&gt;0&lt;/adonis:value&gt;&#xA;        &lt;adonis:metavalue&gt;0&lt;/adonis:metavalue&gt;&#xA;      &lt;/adonis:attribute&gt;&#xA;      &lt;adonis:attribute name=&quot;DISPLAY_SYMBOLS_IF_RISKS_OR_CONTROLS&quot; notebook=&quot;1&quot; novalue=&quot;0&quot; sourcelang=&quot;en&quot; type=&quot;BOOL&quot;&gt;&#xA;        &lt;adonis:value&gt;true&lt;/adonis:value&gt;&#xA;        &lt;adonis:metavalue /&gt;&#xA;      &lt;/adonis:attribute&gt;&#xA;      &lt;adonis:attribute name=&quot;DISPLAY_COOPERATIONPARTICIPATION&quot; notebook=&quot;1&quot; novalue=&quot;0&quot; sourcelang=&quot;en&quot; type=&quot;BOOL&quot;&gt;&#xA;        &lt;adonis:value&gt;false&lt;/adonis:value&gt;&#xA;        &lt;adonis:metavalue /&gt;&#xA;      &lt;/adonis:attribute&gt;&#xA;      &lt;adonis:attribute name=&quot;DISPLAY_SYMBOL_IF_DESCRIPTION&quot; notebook=&quot;1&quot; novalue=&quot;0&quot; sourcelang=&quot;en&quot; type=&quot;BOOL&quot;&gt;&#xA;        &lt;adonis:value&gt;true&lt;/adonis:value&gt;&#xA;        &lt;adonis:metavalue /&gt;&#xA;      &lt;/adonis:attribute&gt;&#xA;      &lt;adonis:attribute name=&quot;COLLECTION_DATATYPE_INPUT&quot; notebook=&quot;1&quot; novalue=&quot;0&quot; sourcelang=&quot;en&quot; type=&quot;BOOL&quot;&gt;&#xA;        &lt;adonis:value&gt;false&lt;/adonis:value&gt;&#xA;        &lt;adonis:metavalue /&gt;&#xA;      &lt;/adonis:attribute&gt;&#xA;      &lt;adonis:attribute name=&quot;MONITORING&quot; notebook=&quot;1&quot; novalue=&quot;0&quot; sourcelang=&quot;en&quot; type=&quot;BOOL&quot;&gt;&#xA;        &lt;adonis:value&gt;false&lt;/adonis:value&gt;&#xA;        &lt;adonis:metavalue /&gt;&#xA;      &lt;/adonis:attribute&gt;&#xA;      &lt;adonis:attribute name=&quot;VISUALISE_REFERENCED_IT_SYSTEM_ELEMENTS&quot; notebook=&quot;1&quot; novalue=&quot;0&quot; sourcelang=&quot;en&quot; type=&quot;BOOL&quot;&gt;&#xA;        &lt;adonis:value&gt;true&lt;/adonis:value&gt;&#xA;        &lt;adonis:metavalue /&gt;&#xA;      &lt;/adonis:attribute&gt;&#xA;      &lt;adonis:attribute name=&quot;A_TRANSPORT_TIME&quot; notebook=&quot;1&quot; novalue=&quot;0&quot; sourcelang=&quot;en&quot; type=&quot;UTC&quot;&gt;&#xA;        &lt;adonis:value&gt;0&lt;/adonis:value&gt;&#xA;        &lt;adonis:metavalue&gt;0&lt;/adonis:metavalue&gt;&#xA;      &lt;/adonis:attribute&gt;&#xA;      &lt;adonis:attribute lang-independent=&quot;v0&quot; name=&quot;REPRESENTATION_NAME_TASK&quot; notebook=&quot;1&quot; novalue=&quot;0&quot; sourcelang=&quot;en&quot; type=&quot;ENUM&quot;&gt;&#xA;        &lt;adonis:value&gt;inside&lt;/adonis:value&gt;&#xA;        &lt;adonis:metavalue /&gt;&#xA;      &lt;/adonis:attribute&gt;&#xA;      &lt;adonis:attribute name=&quot;A_NEED_FOR_ACTION_CS&quot; notebook=&quot;1&quot; novalue=&quot;0&quot; sourcelang=&quot;en&quot; type=&quot;BOOL&quot;&gt;&#xA;        &lt;adonis:value&gt;false&lt;/adonis:value&gt;&#xA;        &lt;adonis:metavalue /&gt;&#xA;      &lt;/adonis:attribute&gt;&#xA;      &lt;adonis:attribute name=&quot;DISPLAY_RESPONSIBLE_FOR_EXECUTION&quot; notebook=&quot;1&quot; novalue=&quot;0&quot; sourcelang=&quot;en&quot; type=&quot;BOOL&quot;&gt;&#xA;        &lt;adonis:value&gt;true&lt;/adonis:value&gt;&#xA;        &lt;adonis:metavalue /&gt;&#xA;      &lt;/adonis:attribute&gt;&#xA;      &lt;adonis:attribute name=&quot;COLLECTION_DATATYPE_OUTPUT&quot; notebook=&quot;1&quot; novalue=&quot;0&quot; sourcelang=&quot;en&quot; type=&quot;BOOL&quot;&gt;&#xA;        &lt;adonis:value&gt;false&lt;/adonis:value&gt;&#xA;        &lt;adonis:metavalue /&gt;&#xA;      &lt;/adonis:attribute&gt;&#xA;      &lt;adonis:attribute name=&quot;AUDITING&quot; notebook=&quot;1&quot; novalue=&quot;0&quot; sourcelang=&quot;en&quot; type=&quot;BOOL&quot;&gt;&#xA;        &lt;adonis:value&gt;false&lt;/adonis:value&gt;&#xA;        &lt;adonis:metavalue /&gt;&#xA;      &lt;/adonis:attribute&gt;&#xA;      &lt;adonis:attribute lang-independent=&quot;v2&quot; name=&quot;OBJECT_TYPE&quot; notebook=&quot;1&quot; novalue=&quot;0&quot; sourcelang=&quot;en&quot; type=&quot;ENUM&quot;&gt;&#xA;        &lt;adonis:value&gt;No entry&lt;/adonis:value&gt;&#xA;        &lt;adonis:metavalue /&gt;&#xA;      &lt;/adonis:attribute&gt;&#xA;      &lt;adonis:attribute name=&quot;COSTS&quot; notebook=&quot;1&quot; novalue=&quot;0&quot; sourcelang=&quot;en&quot; type=&quot;DOUBLE&quot;&gt;&#xA;        &lt;adonis:value&gt;0&lt;/adonis:value&gt;&#xA;        &lt;adonis:metavalue /&gt;&#xA;      &lt;/adonis:attribute&gt;&#xA;      &lt;adonis:attribute name=&quot;DISPLAY_ACCOUNTABLE_FOR_APPROVING_RESULTS&quot; notebook=&quot;1&quot; novalue=&quot;0&quot; sourcelang=&quot;en&quot; type=&quot;BOOL&quot;&gt;&#xA;        &lt;adonis:value&gt;false&lt;/adonis:value&gt;&#xA;        &lt;adonis:metavalue /&gt;&#xA;      &lt;/adonis:attribute&gt;&#xA;      &lt;adonis:attribute name=&quot;DISPLAY_TO_INFORM&quot; notebook=&quot;1&quot; novalue=&quot;0&quot; sourcelang=&quot;en&quot; type=&quot;BOOL&quot;&gt;&#xA;        &lt;adonis:value&gt;false&lt;/adonis:value&gt;&#xA;        &lt;adonis:metavalue /&gt;&#xA;      &lt;/adonis:attribute&gt;&#xA;      &lt;adonis:record name=&quot;A_ATTACHMENT_LIST_CS&quot; /&gt;&#xA;      &lt;adonis:record name=&quot;A_BEHAVIOUR_DEFINITION&quot; /&gt;&#xA;      &lt;adonis:record name=&quot;OPEN_QUESTIONS&quot; /&gt;&#xA;    &lt;/adonis:instance&gt;&#xA;    &lt;triso:dataInputBindings&gt;&#xA;      &lt;dmn:context&gt;&#xA;        &lt;dmn:contextEntry&gt;&#xA;          &lt;dmn:variable id=&quot;_66bb75dc-0d15-4d4a-bff5-1facaa990f9d&quot; name=&quot;ToEmail&quot; typeRef=&quot;feel:string&quot; /&gt;&#xA;          &lt;dmn:literalExpression id=&quot;_e2eb53e8-9147-4829-9e12-227787c00697&quot; expressionLanguage=&quot;https://www.omg.org/spec/DMN/20191111/FEEL/&quot;&gt;&#xA;            &lt;dmn:text&gt;Current Vacation Status.email&lt;/dmn:text&gt;&#xA;          &lt;/dmn:literalExpression&gt;&#xA;        &lt;/dmn:contextEntry&gt;&#xA;        &lt;dmn:contextEntry&gt;&#xA;          &lt;dmn:variable id=&quot;_29bcd07e-f276-4020-9692-974a48f02547&quot; name=&quot;FromEmail&quot; typeRef=&quot;feel:string&quot; /&gt;&#xA;          &lt;dmn:literalExpression id=&quot;_f028dc26-6701-4c27-825f-8dc30432c7ca&quot; expressionLanguage=&quot;https://www.omg.org/spec/DMN/20191111/FEEL/&quot;&gt;&#xA;            &lt;dmn:text&gt;&quot;vacationsystem@eurent.com&quot;&lt;/dmn:text&gt;&#xA;          &lt;/dmn:literalExpression&gt;&#xA;        &lt;/dmn:contextEntry&gt;&#xA;        &lt;dmn:contextEntry&gt;&#xA;          &lt;dmn:variable id=&quot;_4865e6aa-a0ee-484c-8cc0-32a9f5f0011a&quot; name=&quot;Subject&quot; typeRef=&quot;feel:string&quot; /&gt;&#xA;          &lt;dmn:literalExpression id=&quot;_fc8bc676-d687-4fa1-afc3-bc8bdc51458d&quot; expressionLanguage=&quot;https://www.omg.org/spec/DMN/20191111/FEEL/&quot;&gt;&#xA;            &lt;dmn:text&gt;&quot;Vacation Denied&quot;&lt;/dmn:text&gt;&#xA;          &lt;/dmn:literalExpression&gt;&#xA;        &lt;/dmn:contextEntry&gt;&#xA;        &lt;dmn:contextEntry&gt;&#xA;          &lt;dmn:variable id=&quot;_841a17a0-858e-4f7e-9226-f95f34c2468e&quot; name=&quot;Body&quot; typeRef=&quot;feel:string&quot; /&gt;&#xA;          &lt;dmn:literalExpression id=&quot;_d1713c38-e401-4968-b789-e55f0b68e161&quot; expressionLanguage=&quot;http://www.w3.org/1999/xhtml&quot;&gt;&#xA;            &lt;dmn:text&gt;&amp;lt;html&amp;gt;&amp;lt;p&amp;gt;Hi &amp;lt;span class=&quot;feel-expression&quot;&amp;gt;Current Vacation Status.name&amp;lt;/span&amp;gt;,&amp;lt;/p&amp;gt; &amp;lt;p&amp;gt;&amp;amp;nbsp;&amp;lt;/p&amp;gt; &amp;lt;p&amp;gt;Your vacation request from&amp;amp;nbsp;&amp;lt;span class=&quot;feel-expression&quot;&amp;gt;date(From)&amp;lt;/span&amp;gt;&amp;amp;nbsp;to &amp;lt;span class=&quot;feel-expression&quot;&amp;gt;date(To)&amp;lt;/span&amp;gt;&amp;amp;nbsp;was declined for the following reason: &amp;lt;span class=&quot;feel-expression&quot;&amp;gt;Reason&amp;lt;/span&amp;gt;&amp;amp;nbsp;&amp;lt;br /&amp;gt;&amp;lt;br /&amp;gt;&amp;lt;/p&amp;gt; &amp;lt;p&amp;gt;&amp;amp;nbsp;Best regards&amp;lt;/p&amp;gt; &amp;lt;p&amp;gt;&amp;amp;nbsp;&amp;lt;/p&amp;gt; &amp;lt;p&amp;gt;This is an automated message generated by the vacation system.&amp;lt;/p&amp;gt;&amp;lt;/html&amp;gt;&lt;/dmn:text&gt;&#xA;          &lt;/dmn:literalExpression&gt;&#xA;        &lt;/dmn:contextEntry&gt;&#xA;      &lt;/dmn:context&gt;&#xA;    &lt;/triso:dataI