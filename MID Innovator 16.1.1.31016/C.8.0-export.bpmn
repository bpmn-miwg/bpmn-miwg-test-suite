onLanguage=&quot;https://www.omg.org/spec/DMN/20191111/FEEL/&quot;&gt;&#xA;            &lt;dmn:text&gt;Current Vacation Status.name&lt;/dmn:text&gt;&#xA;          &lt;/dmn:literalExpression&gt;&#xA;        &lt;/dmn:contextEntry&gt;&#xA;        &lt;dmn:contextEntry&gt;&#xA;          &lt;dmn:variable id=&quot;_4173880b-a3ae-41e9-8831-df027a1e4093&quot; name=&quot;From&quot; typeRef=&quot;feel:date&quot; /&gt;&#xA;          &lt;dmn:literalExpression id=&quot;_9bed9309-d5e1-4588-b386-0f3ce2f9f1ce&quot; expressionLanguage=&quot;https://www.omg.org/spec/DMN/20191111/FEEL/&quot;&gt;&#xA;            &lt;dmn:text&gt;From&lt;/dmn:text&gt;&#xA;          &lt;/dmn:literalExpression&gt;&#xA;        &lt;/dmn:contextEntry&gt;&#xA;        &lt;dmn:contextEntry&gt;&#xA;          &lt;dmn:variable id=&quot;_34a84a8c-f812-4aff-8185-b88eefe88662&quot; name=&quot;Remaining Vacation Days&quot; typeRef=&quot;feel:number&quot; /&gt;&#xA;          &lt;dmn:literalExpression id=&quot;_5cba8054-9875-411e-b79f-5e6b8d6a45a6&quot; expressionLanguage=&quot;https://www.omg.org/spec/DMN/20191111/FEEL/&quot;&gt;&#xA;            &lt;dmn:text&gt;Current Vacation Status.days&lt;/dmn:text&gt;&#xA;          &lt;/dmn:literalExpression&gt;&#xA;        &lt;/dmn:contextEntry&gt;&#xA;        &lt;dmn:contextEntry&gt;&#xA;          &lt;dmn:variable id=&quot;_34ae3a88-6c59-4568-ab46-424acf554173&quot; name=&quot;To&quot; typeRef=&quot;feel:date&quot; /&gt;&#xA;          &lt;dmn:literalExpression id=&quot;_e45d95b2-30b9-481d-af9e-efd1cbc66140&quot; expressionLanguage=&quot;https://www.omg.org/spec/DMN/20191111/FEEL/&quot;&gt;&#xA;            &lt;dmn:text&gt;To&lt;/dmn:text&gt;&#xA;          &lt;/dmn:literalExpression&gt;&#xA;        &lt;/dmn:contextEntry&gt;&#xA;      &lt;/dmn:context&gt;&#xA;    &lt;/triso:dataInputBindings&gt;&#xA;  &lt;/semantic:extensionElements&gt;&#xA;&lt;/semantic:userTask&gt;" />
