novalue=&quot;0&quot; sourcelang=&quot;en&quot; type=&quot;BOOL&quot;&gt;&#xA;        &lt;adonis:value&gt;false&lt;/adonis:value&gt;&#xA;        &lt;adonis:metavalue /&gt;&#xA;      &lt;/adonis:attribute&gt;&#xA;      &lt;adonis:attribute name=&quot;DISPLAY_TO_INFORM&quot; notebook=&quot;1&quot; novalue=&quot;0&quot; sourcelang=&quot;en&quot; type=&quot;BOOL&quot;&gt;&#xA;        &lt;adonis:value&gt;false&lt;/adonis:value&gt;&#xA;        &lt;adonis:metavalue /&gt;&#xA;      &lt;/adonis:attribute&gt;&#xA;      &lt;adonis:record name=&quot;A_ATTACHMENT_LIST_CS&quot; /&gt;&#xA;      &lt;adonis:record name=&quot;A_BEHAVIOUR_DEFINITION&quot; /&gt;&#xA;      &lt;adonis:record name=&quot;OPEN_QUESTIONS&quot; /&gt;&#xA;    &lt;/adonis:instance&gt;&#xA;    &lt;triso:dataInputBindings&gt;&#xA;      &lt;dmn:context&gt;&#xA;        &lt;dmn:contextEntry&gt;&#xA;          &lt;dmn:variable id=&quot;_15b345fa-3cf9-480c-94af-8254cf893070&quot; name=&quot;ToEmail&quot; typeRef=&quot;feel:string&quot; /&gt;&#xA;          &lt;dmn:literalExpression id=&quot;_8e459a3a-3522-46a9-8fe8-cdc04dce7002&quot; expressionLanguage=&quot;https://www.omg.org/spec/DMN/20191111/FEEL/&quot;&gt;&#xA;            &lt;dmn:text&gt;Current Vacation Status.email&lt;/dmn:text&gt;&#xA;          &lt;/dmn:literalExpression&gt;&#xA;        &lt;/dmn:contextEntry&gt;&#xA;        &lt;dmn:contextEntry&gt;&#xA;          &lt;dmn:variable id=&quot;_8f40b6b3-df95-45c0-a88d-80626d15a942&quot; name=&quot;FromEmail&quot; typeRef=&quot;feel:string&quot; /&gt;&#xA;          &lt;dmn:literalExpression id=&quot;_2699a949-3cf1-4351-b056-6766c9f6d574&quot; expressionLanguage=&quot;https://www.omg.org/spec/DMN/20191111/FEEL/&quot;&gt;&#xA;            &lt;dmn:text&gt;&quot;vacationsystem@eurent.com&quot;&lt;/dmn:text&gt;&#xA;          &lt;/dmn:literalExpression&gt;&#xA;        &lt;/dmn:contextEntry&gt;&#xA;        &lt;dmn:contextEntry&gt;&#xA;          &lt;dmn:variable id=&quot;_69562d60-3953-4633-a726-84032ed4e87d&quot; name=&quot;Subject&quot; typeRef=&quot;feel:string&quot; /&gt;&#xA;          &lt;dmn:literalExpression id=&quot;_85195d1a-718c-4f1b-8dba-8ce4e66e9be8&quot; expressionLanguage=&quot;https://www.omg.org/spec/DMN/20191111/FEEL/&quot;&gt;&#xA;            &lt;dmn:text&gt;&quot;Vacation Approved&quot;&lt;/dmn:text&gt;&#xA;          &lt;/dmn:literalExpression&gt;&#xA;        &lt;/dmn:contextEntry&gt;&#xA;        &lt;dmn:contextEntry&gt;&#xA;          &lt;dmn:variable id=&quot;_f3abd20a-153e-46ed-9e2d-362d962b0622&quot; name=&quot;Body&quot; typeRef=&quot;feel:string&quot; /&gt;&#xA;          &lt;dmn:literalExpression id=&quot;_dbb306bd-0a43-491f-a316-70aea0ca1351&quot; expressionLanguage=&quot;http://www.w3.org/1999/xhtml&quot;&gt;&#xA;            &lt;dmn:text&gt;&amp;lt;html&amp;gt;&amp;lt;p&amp;gt;Hi&amp;amp;nbsp;&amp;lt;span class=&quot;feel-expression&quot;&amp;gt;Current Vacation Status.name&amp;lt;/span&amp;gt;,&amp;lt;/p&amp;gt; &amp;lt;p&amp;gt;&amp;amp;nbsp;&amp;lt;/p&amp;gt; &amp;lt;p&amp;gt;Your vacation request from&amp;amp;nbsp;&amp;lt;span class=&quot;feel-expression&quot;&amp;gt;date(From)&amp;lt;/span&amp;gt;&amp;amp;nbsp;to &amp;lt;span class=&quot;feel-expression&quot;&amp;gt;date(To)&amp;lt;/span&amp;gt;&amp;amp;nbsp;was approved.&amp;lt;/p&amp;gt; &amp;lt;p&amp;gt;&amp;amp;nbsp;&amp;lt;/p&amp;gt; &amp;lt;p&amp;gt;Best regards&amp;lt;/p&amp;gt; &amp;lt;p&amp;gt;&amp;amp;nbsp;&amp;lt;/p&amp;gt; &amp;lt;p&amp;gt;This is an automated message generated by the vacation system.&amp;lt;/p&amp;gt;&amp;lt;/html&amp;gt;&lt;/dmn:text&gt;&#xA;          &lt;/dmn:literalExpression&gt;&#xA;        &lt;/dmn:contextEntry&gt;&#xA;      &lt;/dmn:context&gt;&#xA;    &lt;/triso:dataInputBindings&gt;&#xA;  &lt;/semantic:extensionElements&gt;&#xA;&lt;/semantic:sendTask&gt;" />
