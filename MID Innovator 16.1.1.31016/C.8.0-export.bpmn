              <dmn:literalExpression id="_66bf8a7a-1365-4476-b104-3c742842cd30" expressionLanguage="http://www.w3.org/1999/xhtml">
                <dmn:text>&lt;html&gt;&lt;p&gt;Hi &amp;nbsp;&amp;nbsp;&lt;span class="feel-expression"&gt;Current Vacation Status.name&lt;/span&gt;&amp;nbsp;,&lt;/p&gt; &lt;p&gt;&amp;nbsp;&lt;/p&gt; &lt;p&gt;Your vacation request from&amp;nbsp;&lt;span class="feel-expression"&gt;date(From)&lt;/span&gt;&amp;nbsp;to &lt;span class="feel-expression"&gt;date(To)&lt;/span&gt;&amp;nbsp;was declined for the following reason:&amp;nbsp;&lt;span class="feel-expression"&gt;Reason&lt;/span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;br /&gt;&amp;nbsp;&lt;/p&gt; &lt;p&gt;&amp;nbsp;Best regards&lt;/p&gt; &lt;p&gt;&amp;nbsp;&lt;/p&gt; &lt;p&gt;This is an automated message generated by the vacation system.&lt;/p&gt;&lt;/html&gt;</dmn:text>
