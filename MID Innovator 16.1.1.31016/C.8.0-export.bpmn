          <bpanda:extensionTextTranslation name="BPMN Extension" value="&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-16&quot;?&gt;&#xA;&lt;semantic:serviceTask triso:readOnly=&quot;false&quot; xmlns:triso=&quot;http://www.trisotech.com/2015/triso/modeling&quot; xmlns:semantic=&quot;http://www.omg.org/spec/BPMN/20100524/MODEL&quot; xmlns:zeebe=&quot;http://camunda.org/schema/zeebe/1.0&quot; xmlns:kp=&quot;http://knowprocess.com/bpmn&quot; xmlns:adonis=&quot;http://www.boc-group.com&quot; xmlns:dmn=&quot;https://www.omg.org/spec/DMN/20191111/MODEL/&quot;&gt;&#xA;  &lt;semantic:extensionElements&gt;&#xA;    &lt;zeebe:taskDefinition type=&quot;update&quot; /&gt;&#xA;    &lt;kp:field name=&quot;requestMethod&quot; stringValue=&quot;POST&quot; /&gt;&#xA;    &lt;kp:field expression=&quot;https://crm.knowprocess.com/miwg/contacts/${employeeBadgeNumber}/customFields&quot; name=&quot;requestUrl&quot; stringValue=&quot;https://knowprocess.com&quot; /&gt;&#xA;    &lt;kp:field name=&quot;requestHeaders&quot; stringValue=&quot;Content-Type:application/json&quot; /&gt;&#xA;    &lt;kp:field expression=&quot;{&amp;quot;customFields&amp;quot;:{&amp;quot;vacationDays&amp;quot;:${vacationDays}}}&quot; name=&quot;requestBody&quot; /&gt;&#xA;    &lt;kp:field name=&quot;resultVariablePrefix&quot; stringValue=&quot;upVacation2&quot; /&gt;&#xA;    &lt;kp:field name=&quot;saveRequestVariables&quot; stringValue=&quot;false&quot; /&gt;&#xA;    &lt;kp:field name=&quot;saveResponseParameters&quot; stringValue=&quot;true&quot; /&gt;&#xA;    &lt;adonis:instance&gt;&#xA;      &lt;adonis:attribute lang-independent=&quot;v0&quot; name=&quot;IDENTIFICATION_OF_CHANGES&quot; notebook=&quot;1&quot; novalue=&quot;0&quot; sourcelang=&quot;en&quot; type=&quot;ENUM&quot;&gt;&#xA;        &lt;adonis:value&gt;No change&lt;/adonis:value&gt;&#xA;        &lt;adonis:metavalue /&gt;&#xA;      &lt;/adonis:attribute&gt;&#xA;      &lt;adonis:attribute name=&quot;A_EXECUTION_TIME&quot; notebook=&quot;1&quot; nova