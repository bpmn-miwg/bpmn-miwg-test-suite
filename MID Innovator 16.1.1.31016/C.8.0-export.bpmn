    <bpmn:sendTask isForCompensation="false" startQuantity="1" name="Notify Employee of Approval" id="_93ec9873-edf1-4549-b052-961994ec8234" triso:readOnly="false">
      <bpmn:extensionElements>
        <ino:profilename value="ROOT PROFILE" />
        <ino:stereotypename value="task" />
        <ino:typename value="MID.Innovator.API.icw2bp.BPTaskNode" />
        <adonis:MailTo>${email}</adonis:MailTo>
        <adonis:MailSubject>Your Vacation Request ${SYS.PROCESSINSTANCE_ID} was approved automatically</adonis:MailSubject>
        <adonis:MailBody>Dear ${first-name},
your Vacation Request ${SYS.PROCESSINSTANCE_ID}
from ${fromdatepicker}
to ${todatepicker}
was approved automatically.
Best regards,
Your BOC Adonis Process Automation</adonis:MailBody>
        <zeebe:taskDefinition type="emailService" />
        <zeebe:ioMapping>
          <zeebe:input source="= &quot;&lt;html&gt;&lt;p&gt;Hi  &quot; + Current Vacation Status.name + &quot;,&lt;/p&gt; &lt;p&gt; &lt;/p&gt; &lt;p&gt;Your vacation request from &quot; + From + &quot; to &quot; + To + &quot; was approved.&lt;/p&gt; &lt;p&gt; &lt;/p&gt; &lt;p&gt;Best regards&lt;/p&gt; &lt;p&gt; &lt;/p&gt; &lt;p&gt;This is an automated message generated by the vacation system.&lt;/p&gt;&lt;/html&gt;&quot;" target="mailBody" />
          <zeebe:input source="= &quot;Vacation Approved&quot;" target="mailSubject" />
          <zeebe:input source="= Current Vacation Status.email" target="mailAddress" />
        </zeebe:ioMapping>
        <kp:field name="to" stringValue="info@knowprocess.com" />
        <kp:field name="htmlVar" stringValue="vacationApproved" />
        <adonis:instance>
          <adonis:attribute lang-independent="v0" name="IDENTIFICATION_OF_CHANGES" notebook="1" novalue="0" sourcelang="en" type="ENUM">
            <adonis:value>No change</adonis:value>
            <adonis:metavalue />
          </adonis:attribute>
          <adonis:attribute name="A_EXECUTION_TIME" notebook="1" novalue="0" sourcelang="en" type="UTC">
            <adonis:value>0</adonis:value>
            <adonis:metavalue>0</adonis:metavalue>
          </adonis:attribute>
          <adonis:attribute name="A_RESTING_TIME" notebook="1" novalue="0" sourcelang="en" type="UTC">
            <adonis:value>0</adonis:value>
            <adonis:metavalue>0</adonis:metavalue>
          </adonis:attribute>
          <adonis:attribute name="A_WAITING_TIME" notebook="1" novalue="0" sourcelang="en" type="UTC">
            <adonis:value>0</adonis:value>
            <adonis:metavalue>0</adonis:metavalue>
          </adonis:attribute>
          <adonis:attribute name="DISPLAY_SYMBOLS_IF_RISKS_OR_CONTROLS" notebook="1" novalue="0" sourcelang="en" type="BOOL">
            <adonis:value>true</adonis:value>
            <adonis:metavalue />
          </adonis:attribute>
          <adonis:attribute name="DISPLAY_COOPERATIONPARTICIPATION" notebook="1" novalue="0" sourcelang="en" type="BOOL">
            <adonis:value>false</adonis:value>
            <adonis:metavalue />
          </adonis:attribute>
          <adonis:attribute name="DISPLAY_SYMBOL_IF_DESCRIPTION" notebook="1" novalue="0" sourcelang="en" type="BOOL">
            <adonis:value>true</adonis:value>
            <adonis:metavalue />
          </adonis:attribute>
          <adonis:attribute name="COLLECTION_DATATYPE_INPUT" notebook="1" novalue="0" sourcelang="en" type="BOOL">
            <adonis:value>false</adonis:value>
            <adonis:metavalue />
          </adonis:attribute>
          <adonis:attribute name="MONITORING" notebook="1" novalue="0" sourcelang="en" type="BOOL">
            <adonis:value>false</adonis:value>
            <adonis:metavalue />
          </adonis:attribute>
