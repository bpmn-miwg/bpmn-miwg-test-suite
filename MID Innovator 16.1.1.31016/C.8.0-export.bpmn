    <bpmn:sendTask isForCompensation="false" startQuantity="1" name="Notify Employee of Refusal" id="_02232e32-c3d2-473c-a15d-9c5dca00eadc" triso:readOnly="false">
      <bpmn:extensionElements>
        <ino:profilename value="ROOT PROFILE" />
        <ino:stereotypename value="task" />
        <ino:typename value="MID.Innovator.API.icw2bp.BPTaskNode" />
        <adonis:MailTo>${email}</adonis:MailTo>
        <adonis:MailSubject>Your Vacation Request ${SYS.PROCESSINSTANCE_ID} was refused manually</adonis:MailSubject>
        <adonis:MailBody>Dear ${first-name},
unfortunately your Vacation Request ${SYS.PROCESSINSTANCE_ID}
from ${fromdatepicker}
to ${todatepicker}
was refused manually.
Comment: ${comment}
Please consider the refusal comment and create a new request if necessary.
Best regards,
Your BOC Adonis Process Automation</adonis:MailBody>
        <zeebe:taskDefinition type="emailService" />
        <zeebe:ioMapping>
          <zeebe:input source="= &quot;&lt;html&gt;&lt;p&gt;Hi  &quot; + Current Vacation Status.name + &quot;,&lt;/p&gt; &lt;p&gt; &lt;/p&gt; &lt;p&gt;Your vacation request from &quot; + From + &quot; to &quot; + To + &quot; was declined for the following reason: &quot; + Reason + &quot;&lt;/p&gt; &lt;p&gt; &lt;/p&gt; &lt;p&gt;Best regards&lt;/p&gt; &lt;p&gt; &lt;/p&gt; &lt;p&gt;This is an automated message generated by the vacation system.&lt;/p&gt;&lt;/html&gt;&quot;" target="mailBody" />
          <zeebe:input source="= source" target="mailSubject" />
          <zeebe:input source="= Current Vacation Status.email" target="mailAddress" />
        </zeebe:ioMapping>
        <kp:field name="to" stringValue="info@knowprocess.com" />
        <kp:field name="htmlVar" stringValue="vacationRefused" />
        <adonis:instance>
          <adonis:attribute lang-independent="v0" name="IDENTIFICATION_OF_CHANGES" notebook="1" novalue="0" sourcelang="en" type="ENUM">
            <adonis:value>No change</adonis:value>
            <adonis:metavalue />
          </adonis:attribute>
          <adonis:attribute name="A_EXECUTION_TIME" notebook="1" novalue="0" sourcelang="en" type="UTC">
            <adonis:value>0</adonis:value>
            <adonis:metavalue>0</adonis:metavalue>
          </adonis:attribute>
          <adonis:attribute name="A_RESTING_TIME" notebook="1" novalue="0" sourcelang="en" type="UTC">
            <adonis:value>0</adonis:value>
            <adonis:metavalue>0</adonis:metavalue>
          </adonis:attribute>
          <adonis:attribute name="A_WAITING_TIME" notebook="1" novalue="0" sourcelang="en" type="UTC">
