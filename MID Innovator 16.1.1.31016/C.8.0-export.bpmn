              <dmn:literalExpression id="_d1713c38-e401-4968-b789-e55f0b68e161" expressionLanguage="http://www.w3.org/1999/xhtml">
                <dmn:text>&lt;html&gt;&lt;p&gt;Hi &lt;span class="feel-expression"&gt;Current Vacation Status.name&lt;/span&gt;,&lt;/p&gt; &lt;p&gt;&amp;nbsp;&lt;/p&gt; &lt;p&gt;Your vacation request from&amp;nbsp;&lt;span class="feel-expression"&gt;date(From)&lt;/span&gt;&amp;nbsp;to &lt;span class="feel-expression"&gt;date(To)&lt;/span&gt;&amp;nbsp;was declined for the following reason: &lt;span class="feel-expression"&gt;Reason&lt;/span&gt;&amp;nbsp;&lt;br /&gt;&lt;br /&gt;&lt;/p&gt; &lt;p&gt;&amp;nbsp;Best regards&lt;/p&gt; &lt;p&gt;&amp;nbsp;&lt;/p&gt; &lt;p&gt;This is an automated message generated by the vacation system.&lt;/p&gt;&lt;/html&gt;</dmn:text>
              </dmn:literalExpression>
            </dmn:contextEntry>
          </dmn:context>
