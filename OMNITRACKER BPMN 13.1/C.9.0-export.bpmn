	<sem:collaboration id="_3" ot:outerProcess="_4">
		<sem:participant id="_5" name="Customer Onboarding" processRef="_6"/>
	</sem:collaboration>
	<sem:process name="process1" ot:alias="process1" id="_4">
		<sem:documentation textFormat="application/x-ot-schemaObjectDescription">
			<ot:schemaObjectDescription>
				<ot:translatedText lang="de"/>
			</ot:schemaObjectDescription>
		</sem:documentation>
