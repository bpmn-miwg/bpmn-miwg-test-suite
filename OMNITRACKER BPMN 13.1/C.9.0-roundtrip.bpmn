	<sem:process name="Customer Onboarding" ot:alias="process1" ot:displayName="Customer Onboarding" id="_9">
		<sem:extensionElements>
			<ot:startPermission/>
		</sem:extensionElements>
		<sem:sequenceFlow id="_10" ot:alias="flow13" sourceRef="_11" targetRef="_12"/>
		<sem:sequenceFlow id="_13" ot:alias="flow21" sourceRef="_14" targetRef="_15"/>
		<sem:sequenceFlow id="_16" ot:alias="flow20" sourceRef="_17" targetRef="_14"/>
		<sem:sequenceFlow id="_18" ot:alias="flow19" sourceRef="_19" targetRef="_20"/>
		<sem:sequenceFlow id="_21" name="Yellow (moderate risk)" ot:displayName="Yellow (moderate risk)" ot:alias="flow18" sourceRef="_22" targetRef="_19">
			<sem:documentation textFormat="application/x-ot-schemaObjectDescription">
				<ot:schemaObjectDescription>
					<ot:translatedText lang="de">Manual check - moderate risk</ot:translatedText>
				</ot:schemaObjectDescription>
			</sem:documentation>
			<sem:conditionExpression>= every risk in riskLevels satisfies risk = "yellow"</sem:conditionExpression>
		</sem:sequenceFlow>
		<sem:sequenceFlow id="_23" ot:alias="flow17" sourceRef="_24" targetRef="_25"/>
		<sem:sequenceFlow id="_26" name="Application declined" ot:displayName="Application declined" ot:alias="flow16" sourceRef="_20" targetRef="_27">
			<sem:conditionExpression>= not(approved)</sem:conditionExpression>
		</sem:sequenceFlow>
		<sem:sequenceFlow id="_28" ot:alias="flow14" sourceRef="_12" targetRef="_29"/>
		<sem:sequenceFlow id="_30" name="Green (no risk)" ot:displayName="Green (no risk)" ot:alias="flow12" sourceRef="_22" targetRef="_11">
			<sem:documentation textFormat="application/x-ot-schemaObjectDescription">
				<ot:schemaObjectDescription>
					<ot:translatedText lang="de">Automatic approval - no risk</ot:translatedText>
				</ot:schemaObjectDescription>
			</sem:documentation>
		</sem:sequenceFlow>
		<sem:sequenceFlow id="_31" ot:alias="flow11" sourceRef="_32" targetRef="_22"/>
		<sem:sequenceFlow id="_33" name="Red (severe risk)" ot:displayName="Red (severe risk)" ot:alias="flow10" sourceRef="_22" targetRef="_27">
			<sem:documentation textFormat="application/x-ot-schemaObjectDescription">
				<ot:schemaObjectDescription>
					<ot:translatedText lang="de">Automatic rejection -severe risk</ot:translatedText>
				</ot:schemaObjectDescription>
			</sem:documentation>
			<sem:conditionExpression>= some risk in riskLevels satisfies risk = "red"</sem:conditionExpression>
		</sem:sequenceFlow>
		<sem:sequenceFlow id="_34" ot:alias="flow9" sourceRef="_35" targetRef="_36"/>
		<sem:sequenceFlow id="_37" ot:alias="flow8" sourceRef="_27" targetRef="_35"/>
		<sem:sequenceFlow id="_38" ot:alias="flow7" sourceRef="_25" targetRef="_32"/>
		<sem:sequenceFlow id="_39" name="Application accepted" ot:displayName="Application accepted" ot:alias="flow15" sourceRef="_20" targetRef="_11">
			<sem:conditionExpression>= approved</sem:conditionExpression>
		</sem:sequenceFlow>
		<sem:exclusiveGateway id="_20" name="Decision?" ot:displayName="Decision?" ot:alias="gateway1"/>
		<sem:subProcess id="_40" name="Activity_0vp33kx" ot:displayName="Activity_0vp33kx" ot:subProcessAlias="subProcess2" ot:alias="process3" triggeredByEvent="true">
			<sem:sequenceFlow id="_41" ot:alias="flow6" sourceRef="_42" targetRef="_43"/>
