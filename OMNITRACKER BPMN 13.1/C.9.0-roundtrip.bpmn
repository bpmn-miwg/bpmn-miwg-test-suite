				<sem:dataOutputRefs>_d_61</sem:dataOutputRefs>
			</sem:outputSet>
			<sem:errorEventDefinition errorRef="_2"/>
		</sem:boundaryEvent>
		<sem:endEvent id="_36" name="Application &#xA;rejected" ot:displayName="Application &#xA;rejected" ot:alias="event3">
			<sem:documentation textFormat="application/x-ot-schemaObjectDescription">
				<ot:schemaObjectDescription>
					<ot:translatedText lang="de">Customer onboarding process end application rejected</ot:translatedText>
				</ot:schemaObjectDescription>
			</sem:documentation>
		</sem:endEvent>
		<sem:endEvent id="_29" name="Application&#xA; issued" ot:displayName="Application&#xA; issued" ot:alias="event2">
			<sem:documentation textFormat="application/x-ot-schemaObjectDescription">
				<ot:schemaObjectDescription>
					<ot:translatedText lang="de">Customer onboarding process end application issued</ot:translatedText>
				</ot:schemaObjectDescription>
			</sem:documentation>
		</sem:endEvent>
		<sem:startEvent id="_24" name="Application received" ot:displayName="Application received" ot:alias="event1"/>
		<sem:endEvent id="_15" name="Application canceled due to fraud" ot:displayName="Application canceled due to fraud" ot:alias="event5">
			<sem:documentation textFormat="application/x-ot-schemaObjectDescription">
				<ot:schemaObjectDescription>
