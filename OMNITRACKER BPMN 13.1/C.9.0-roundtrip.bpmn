			<sem:sequenceFlow id="_48" ot:alias="flow3" sourceRef="_49" targetRef="_47"/>
			<sem:endEvent id="_45" name="Customer notified about successful cancelation" ot:displayName="Customer notified about successful cancelation" ot:alias="event9">
				<sem:dataInput id="_d_50"/>
				<sem:documentation textFormat="application/x-ot-schemaObjectDescription">
					<ot:schemaObjectDescription>
						<ot:translatedText lang="de">Inform customer of a successful cancelation</ot:translatedText>
					</ot:schemaObjectDescription>
				</sem:documentation>
				<sem:inputSet>
					<sem:dataInputRefs>_d_50</sem:dataInputRefs>
				</sem:inputSet>
				<sem:messageEventDefinition/>
			</sem:endEvent>
			<sem:endEvent id="_43" name="Operations Team notified about successful cancelation" ot:displayName="Operations Team notified about successful cancelation" ot:alias="event10">
				<sem:dataInput id="_d_51"/>
				<sem:documentation textFormat="application/x-ot-schemaObjectDescription">
					<ot:schemaObjectDescription>
						<ot:translatedText lang="de">Inform operations team of a successful cancelation</ot:translatedText>
					</ot:schemaObjectDescription>
				</sem:documentation>
				<sem:inputSet>
					<sem:dataInputRefs>_d_51</sem:dataInputRefs>
				</sem:inputSet>
				<sem:messageEventDefinition/>
			</sem:endEvent>
			<sem:startEvent id="_49" name="Cancelation requested" ot:displayName="Cancelation requested" ot:alias="event8">
				<sem:documentation textFormat="application/x-ot-schemaObjectDescription">
					<ot:schemaObjectDescription>
						<ot:translatedText lang="de">Customer onboarding cancellation message received</ot:translatedText>
					</ot:schemaObjectDescription>
				</sem:documentation>
				<sem:dataOutput id="_d_52"/>
				<sem:outputSet>
					<sem:dataOutputRefs>_d_52</sem:dataOutputRefs>
				</sem:outputSet>
				<sem:messageEventDefinition messageRef="_4"/>
			</sem:startEvent>
			<sem:serviceTask id="_47" name="Cancel application" ot:displayName="Cancel application" ot:alias="task9" ot:connectorGuid="{00000000-0000-0000-0000-000000000000}">
				<sem:documentation textFormat="application/x-ot-schemaObjectDescription">
					<ot:schemaObjectDescription>
						<ot:translatedText lang="de">Cancel application</ot:translatedText>
					</ot:schemaObjectDescription>
				</sem:documentation>
			</sem:serviceTask>
			<sem:parallelGateway id="_42" ot:alias="gateway3"/>
		</sem:subProcess>
		<sem:subProcess id="_53" name="Activity_1ke2ixr" ot:displayName="Activity_1ke2ixr" ot:subProcessAlias="subProcess1" ot:alias="process2" triggeredByEvent="true">
			<sem:sequenceFlow id="_54" ot:alias="flow1" sourceRef="_55" targetRef="_56"/>
			<sem:sequenceFlow id="_57" ot:alias="flow2" sourceRef="_56" targetRef="_58"/>
			<sem:userTask id="_56" name="Handle Timeout" ot:displayName="Handle Timeout" ot:alias="task8">
				<sem:documentation textFormat="application/x-ot-schemaObjectDescription">
					<ot:schemaObjectDescription>
						<ot:translatedText lang="de">Manually handles the timeout</ot:translatedText>
					</ot:schemaObjectDescription>
				</sem:documentation>
				<sem:extensionElements>
					<ot:userTaskDefinition title="" description="" dueDate="" responsible="" alsoVisibleFor="" formType="ruleBased" displayShowProcessButton="false" displayOkButton="false" displayApplyButton="false" formTitle="" otObject="" reassignMode="explicit"/>
				</sem:extensionElements>
			</sem:userTask>
			<sem:startEvent id="_55" name="Timeout" ot:displayName="Timeout" ot:alias="event7">
				<sem:documentation textFormat="application/x-ot-schemaObjectDescription">
					<ot:schemaObjectDescription>
						<ot:translatedText lang="de">Catches timeout error event and starts the subprocess</ot:translatedText>
					</ot:schemaObjectDescription>
				</sem:documentation>
				<sem:dataOutput id="_d_59"/>
				<sem:outputSet>
					<sem:dataOutputRefs>_d_59</sem:dataOutputRefs>
				</sem:outputSet>
				<sem:errorEventDefinition errorRef="_3"/>
			</sem:startEvent>
			<sem:endEvent id="_58" name="Timeout handled" ot:displayName="Timeout handled" ot:alias="event6">
				<sem:dataInput id="_d_60"/>
				<sem:documentation textFormat="application/x-ot-schemaObjectDescription">
					<ot:schemaObjectDescription>
						<ot:translatedText lang="de">Ends the subprocess and send message timeout handled</ot:translatedText>
					</ot:schemaObjectDescription>
				</sem:documentation>
				<sem:inputSet>
					<sem:dataInputRefs>_d_60</sem:dataInputRefs>
				</sem:inputSet>
				<sem:messageEventDefinition/>
			</sem:endEvent>
		</sem:subProcess>
		<sem:callActivity id="_19" name="Manual Check" ot:displayName="Manual Check" ot:alias="activity1"/>
		<sem:sendTask id="_14" name="Report fraud" ot:displayName="Report fraud" ot:alias="task7">
