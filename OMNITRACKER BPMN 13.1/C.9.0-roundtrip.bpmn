		<sem:serviceTask id="_25" name="Get credit score" ot:displayName="Get credit score" ot:alias="task6" ot:connectorGuid="{00000000-0000-0000-0000-000000000000}">
			<sem:documentation textFormat="application/x-ot-schemaObjectDescription">
				<ot:schemaObjectDescription>
					<ot:translatedText lang="de">Gets credit score for prospect client</ot:translatedText>
				</ot:schemaObjectDescription>
			</sem:documentation>
		</sem:serviceTask>
		<sem:serviceTask id="_35" name="Send rejection" ot:displayName="Send rejection" ot:alias="task5" ot:connectorGuid="{00000000-0000-0000-0000-000000000000}"/>
		<sem:serviceTask id="_27" name="Reject application" ot:displayName="Reject application" ot:alias="task4" ot:connectorGuid="{00000000-0000-0000-0000-000000000000}">
			<sem:documentation textFormat="application/x-ot-schemaObjectDescription">
				<ot:schemaObjectDescription>
					<ot:translatedText lang="de">Reject policy</ot:translatedText>
				</ot:schemaObjectDescription>
			</sem:documentation>
		</sem:serviceTask>
		<sem:serviceTask id="_11" name="Deliver confirmation" ot:displayName="Deliver confirmation" ot:alias="task3" ot:connectorGuid="{00000000-0000-0000-0000-000000000000}">
			<sem:documentation textFormat="application/x-ot-schemaObjectDescription">
				<ot:schemaObjectDescription>
					<ot:translatedText lang="de">Deliver policy</ot:translatedText>
				</ot:schemaObjectDescription>
			</sem:documentation>
		</sem:serviceTask>
		<sem:serviceTask id="_12" name="Send confirmation" ot:displayName="Send confirmation" ot:alias="task2" ot:connectorGuid="{00000000-0000-0000-0000-000000000000}"/>
		<sem:businessRuleTask id="_32" name="Check application automatically" ot:displayName="Check application automatically" ot:alias="task1">
			<sem:documentation textFormat="application/x-ot-schemaObjectDescription">
				<ot:schemaObjectDescription>
					<ot:translatedText lang="de">Identify risk for prospect client</ot:translatedText>
				</ot:schemaObjectDescription>
			</sem:documentation>
		</sem:businessRuleTask>
		<sem:exclusiveGateway id="_22" name="Risk?" ot:displayName="Risk?" ot:alias="gateway2">
			<sem:documentation textFormat="application/x-ot-schemaObjectDescription">
				<ot:schemaObjectDescription>
					<ot:translatedText lang="de">Route process based on risk, "green" automatic onboarding, "yellow" manual check, "red" automatic rejection</ot:translatedText>
				</ot:schemaObjectDescription>
			</sem:documentation>
		</sem:exclusiveGateway>
		<sem:boundaryEvent id="_17" name="Fraud detected" ot:displayName="Fraud detected" ot:alias="event4" attachedToRef="_19">
			<sem:documentation textFormat="application/x-ot-schemaObjectDescription">
				<ot:schemaObjectDescription>
					<ot:translatedText lang="de">Captures error if fraud is detected</ot:translatedText>
				</ot:schemaObjectDescription>
			</sem:documentation>
			<sem:dataOutput id="_d_61"/>
