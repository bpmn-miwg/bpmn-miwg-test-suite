	<sem:message id="_2" name="Service Level" ot:alias="message1" ot:namespace="_1"/>
	<sem:process name="Fridge Repair Process" ot:alias="process1" ot:displayName="Fridge Repair Process" id="_4">
		<sem:extensionElements>
			<ot:startPermission/>
		</sem:extensionElements>
		<sem:sequenceFlow id="_5" ot:alias="flow1" sourceRef="_6" targetRef="_7"/>
		<sem:sequenceFlow id="_8" name="Warranty" ot:displayName="Warranty" ot:alias="flow2" sourceRef="_7" targetRef="_9"/>
		<sem:sequenceFlow id="_10" name="Emergency service" ot:displayName="Emergency service" ot:alias="flow3" sourceRef="_7" targetRef="_11"/>
		<sem:sequenceFlow id="_12" name="Regular repair service" ot:displayName="Regular repair service" ot:alias="flow4" sourceRef="_7" targetRef="_13"/>
		<sem:sequenceFlow id="_14" name="Standard" ot:displayName="Standard" ot:alias="flow5" sourceRef="_13" targetRef="_15"/>
		<sem:sequenceFlow id="_16" name="Premium" ot:displayName="Premium" ot:alias="flow6" sourceRef="_13" targetRef="_17">
			<sem:conditionExpression>Service Level == 'Premium'</sem:conditionExpression>
		</sem:sequenceFlow>
		<sem:sequenceFlow id="_18" ot:alias="flow7" sourceRef="_15" targetRef="_19"/>
		<sem:sequenceFlow id="_20" ot:alias="flow8" sourceRef="_17" targetRef="_19"/>
