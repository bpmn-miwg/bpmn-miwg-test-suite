		<sem:sequenceFlow id="_28" ot:alias="flow13" sourceRef="_29" targetRef="_6"/>
		<sem:sequenceFlow id="_30" ot:alias="flow14" sourceRef="_31" targetRef="_11"/>
		<sem:sequenceFlow id="_32" ot:alias="flow15" sourceRef="_33" targetRef="_17"/>
		<sem:startEvent id="_29" name="Receive customer request" ot:displayName="Receive customer request" ot:alias="event1">
			<sem:dataOutput id="_d_34"/>
			<sem:outputSet>
				<sem:dataOutputRefs>_d_34</sem:dataOutputRefs>
			</sem:outputSet>
			<sem:messageEventDefinition messageRef="_2"/>
		</sem:startEvent>
		<sem:exclusiveGateway id="_7" name="Service type" ot:displayName="Service type" ot:alias="gateway1"/>
		<sem:subProcess id="_11" name="Perform emergency repair" ot:displayName="Perform emergency repair" ot:subProcessAlias="subProcess1" ot:alias="process2">
			<sem:documentation textFormat="application/x-ot-schemaObjectDescription">
				<ot:schemaObjectDescription>
					<ot:translatedText lang="de">This is a special case for handling emergencies for clients such as Hospitals or Commercial fridges.</ot:translatedText>
				</ot:schemaObjectDescription>
			</sem:documentation>
		</sem:subProcess>
		<sem:userTask id="_17" name="Perform repair (premium level)" ot:displayName="Perform repair (premium level)" ot:alias="task4">
			<sem:documentation textFormat="application/x-ot-schemaObjectDescription">
				<ot:schemaObjectDescription>
					<ot:translatedText lang="de">These customers get special service in case of damage.
This service level guarantees less than two days to solve the issue.</ot:translatedText>
				</ot:schemaObjectDescription>
			</sem:documentation>
			<sem:extensionElements>
				<ot:userTaskDefinition title="" description="" dueDate="" responsible="" alsoVisibleFor="" formType="ruleBased" displayShowProcessButton="false" displayOkButton="false" displayApplyButton="false" formTitle="" otObject="" reassignMode="explicit"/>
			</sem:extensionElements>
		</sem:userTask>
		<sem:userTask id="_15" name="Perform repair (standard level)" ot:displayName="Perform repair (standard level)" ot:alias="task3">
			<sem:documentation textFormat="application/x-ot-schemaObjectDescription">
				<ot:schemaObjectDescription>
					<ot:translatedText lang="de">Standard service level is common for most customer support.
This level guarantees the fridge will be repaired in a reasonable amount of time.
Customers may decide to raise the service level to Premium while waiting for the standard service to solve the issue.</ot:translatedText>
				</ot:schemaObjectDescription>
			</sem:documentation>
			<sem:extensionElements>
				<ot:userTaskDefinition title="" description="" dueDate="" responsible="" alsoVisibleFor="" formType="ruleBased" displayShowProcessButton="false" displayOkButton="false" displayApplyButton="false" formTitle="" otObject="" reassignMode="explicit"/>
			</sem:extensionElements>
		</sem:userTask>
		<sem:userTask id="_9" name="Replace fridge" ot:displayName="Replace fridge" ot:alias="task2">
			<sem:documentation textFormat="application/x-ot-schemaObjectDescription">
				<ot:schemaObjectDescription>
					<ot:translatedText lang="de">Fridge replaced if still under warranty.</ot:translatedText>
				</ot:schemaObjectDescription>
			</sem:documentation>
			<sem:extensionElements>
				<ot:userTaskDefinition title="" description="" dueDate="" responsible="" alsoVisibleFor="" formType="ruleBased" displayShowProcessButton="false" displayOkButton="false" displayApplyButton="false" formTitle="" otObject="" reassignMode="explicit"/>
			</sem:extensionElements>
		</sem:userTask>
		<sem:userTask id="_6" name="Analyse customer request" ot:displayName="Analyse customer request" ot:alias="task1" startQuantity="2" completionQuantity="2">
			<sem:documentation textFormat="application/x-ot-schemaObjectDescription">
				<ot:schemaObjectDescription>
					<ot:translatedText lang="de">First contact with customer</ot:translatedText>
				</ot:schemaObjectDescription>
			</sem:documentation>
			<sem:extensionElements>
				<ot:userTaskDefinition title="" description="" dueDate="" responsible="" alsoVisibleFor="" formType="ruleBased" displayShowProcessButton="false" displayOkButton="false" displayApplyButton="false" formTitle="" otObject="" reassignMode="explicit"/>
			</sem:extensionElements>
		</sem:userTask>
		<sem:exclusiveGateway id="_13" name="Service level" ot:displayName="Service level" ot:alias="gateway2"/>
		<sem:boundaryEvent id="_33" ot:alias="event6" attachedToRef="_15">
			<sem:dataOutput id="_d_35"/>
			<sem:outputSet>
				<sem:dataOutputRefs>_d_35</sem:dataOutputRefs>
			</sem:outputSet>
			<sem:messageEventDefinition messageRef="_2"/>
		</sem:boundaryEvent>
		<sem:boundaryEvent id="_31" name="2 hours" ot:displayName="2 hours" ot:alias="event5" attachedToRef="_17">
			<sem:timerEventDefinition>
				<sem:timeDuration>PT2H</sem:timeDuration>
			</sem:timerEventDefinition>
		</sem:boundaryEvent>
		<sem:endEvent id="_19" name="Repair completed" ot:displayName="Repair completed" ot:alias="event4"/>
		<sem:endEvent id="_26" name="Emergency repair completed" ot:displayName="Emergency repair completed" ot:alias="event3"/>
		<sem:endEvent id="_24" name="Fridge replaced" ot:displayName="Fridge replaced" ot:alias="event2"/>
		<sem:exclusiveGateway id="_22" name="Successful?" ot:displayName="Successful?" ot:alias="gateway3"/>
	</sem:process>
