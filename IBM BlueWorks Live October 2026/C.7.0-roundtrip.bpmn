                        </ns2:property>
                    </ns2:properties>
                </ns2:bpmAttributes>
            </extensionElements>
            <performer name="Recruiter">
                <resourceRef xmlns:res="http://www.ibm.com/WebSphere/bpm/BlueworksLive/Resources">res:bpmn-03f30f1e-08e5-4f46-861a-1dc1b3913d1e</resourceRef>
            </performer>
        </userTask>
        <userTask name="Approve advertisement" id="bpmn-8a250ec4-e92d-448c-9c0f-2364576eb16c">
            <documentation textFormat="text/html">&lt;p&gt;The job description edited to a job advertisement has to be checked and approved.&lt;/p&gt;</documentation>
            <performer name="Hiring Manager">
