        <userTask name="Write &#10;description" id="bpmn-e23f0838-fd77-44ca-9909-2432db189c9e">
            <documentation textFormat="text/html">&lt;p&gt;A very specific requirement to the job vacancy has to be written and forwarded to the recruitment department.&lt;/p&gt;</documentation>
            <performer name="Hiring Manager">
                <resourceRef xmlns:res="http://www.ibm.com/WebSphere/bpm/BlueworksLive/Resources">res:bpmn-d9e46c6d-47be-4f49-8771-fe63170ada0b</resourceRef>
            </performer>
        </userTask>
        <userTask name="Complete advertisement" id="bpmn-15dccea2-de57-4f75-9177-45224d1ae4fd">
            <documentation textFormat="text/html">&lt;p&gt;The job description received from the specialist department has to be completed (layout, additional information etc.) to a job advertisement in accordance to the guidelines and approved by the Hiring Manager.&lt;/p&gt;</documentation>
            <extensionElements>
                <ns2:bpmAttributes>
                    <ns2:properties>
                        <ns2:property id="bpmn-8c518292-3d67-41a2-9d35-87c7068d4256">
